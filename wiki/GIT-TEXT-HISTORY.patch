ne{font-size:.875rem;color:var(--muted)}footer{display:flex;align-items:center;gap:20px;justify-content:space-between;border-top:1px solid var(--line);padding:12px 4vw;background:white;z-index:2}.page-label{font-size:.875rem;color:var(--muted)}.nav{display:flex;gap:10px}button{padding:10px 18px;border:1px solid var(--line);border-radius:7px;background:white;color:var(--ink);font-size:1rem;min-height:44px}.primary{background:var(--blue);border-color:var(--blue);color:white}.intro-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:30px;margin:20px 0}.instructions{padding:22px 26px;background:var(--soft);border-radius:10px}.instructions p{margin:0 0 14px}.instructions p:last-child{margin-bottom:0}.rounds{display:grid;gap:14px}.round-card{padding:14px 18px;border:1px solid var(--line);border-radius:9px}.round-card strong{color:var(--blue)}.round-card:last-child strong{color:var(--coral)}.round-card p{margin:5px 0 0}.experiment{border:1px solid #b7c6f1;border-radius:14px;max-width:860px;margin:28px auto 22px;padding:22px 30px;text-align:center;background:white;box-shadow:0 8px 35px #21386e0b}.exp-top{display:flex;justify-content:space-between;gap:15px;align-items:center;font-size:.875rem;color:var(--muted)}.rule{display:inline-block;color:var(--blue);background:var(--pale);border:1px solid #c2cef9;padding:6px 18px;border-radius:100px;font-size:1rem;font-weight:700}.stimulus{font-size:clamp(3.5rem,8vw,6rem);line-height:1.5;min-height:140px;display:flex;align-items:center;justify-content:center;font-weight:750;margin:8px 0}.answers{display:grid;grid-template-columns:1fr 1fr;gap:16px;max-width:550px;margin:0 auto}.answers button{padding:16px 12px;font-size:1.2rem;background:var(--soft)}.answers kbd{font-size:.875rem;display:block;color:var(--muted);font-family:inherit}.status{font-size:1rem;line-height:1.8;min-height:30px;margin:15px 0}.actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:15px}details{max-width:1050px;border-top:1px solid var(--line);margin:22px 0 0;padding-top:13px}summary{cursor:pointer;font-size:1rem;font-weight:650}details p{font-size:.875rem;color:var(--muted);line-height:1.95;margin:12px 0}.results{border:1px solid var(--line);border-radius:12px;margin:25px auto;padding:24px;max-width:860px}.results[hidden]{display:none}.result-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:16px 0}.result-item{padding:18px;background:var(--soft);border-radius:8px}.result-item strong{display:block;font-size:1.7rem;color:var(--blue);line-height:1.7}.result-item p{margin:0;font-size:.875rem;color:var(--muted)}.interpret{padding:16px 20px;background:var(--pale);font-size:1rem;border-radius:8px;margin:18px 0 0}.results h2{margin:0}.result-empty{color:var(--muted)}dialog{max-width:760px;width:92vw;max-height:85dvh;overflow:auto;padding:25px;border:1px solid var(--line);border-radius:14px;color:var(--ink)}dialog::backdrop{background:#17223d80}dialog p{font-size:1rem;overflow-wrap:anywhere}dialog .actions{justify-content:flex-end}.source-entry{border-top:1px solid var(--line);padding-top:15px}.keyboard-hint{font-size:.875rem;color:var(--muted)}.print-only{display:none} @media(max-width:800px){.arrangement,.intro-grid{grid-template-columns:minmax(0,1fr)}.arrangement-intro{border-right:0;border-bottom:1px solid var(--line)}.route{gap:18px;margin-bottom:20px}.arrangement-content{padding:18px}.experiment{padding:20px 16px}.sample-tag,.keyboard-hint{display:none}.lead{font-size:1.05rem}.timeline{grid-template-columns:65px minmax(0,1fr);gap:8px}.axis{margin-left:73px}.task{font-size:.9rem;padding:8px 4px}.experiment .stimulus{min-height:110px}.result-grid{grid-template-columns:1fr}.exp-top{align-items:flex-start;flex-direction:column}.page-label{max-width:45%}footer{gap:8px;padding:10px 5vw}.nav button{padding:8px 12px}.brand{font-size:.875rem}main{padding:18px 5vw 36px}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}@media print{body{height:auto;display:block}header,footer,button,select,dialog{display:none!important}main{overflow:visible;padding:0}.slide,.slide[hidden]{display:block;break-after:page;padding:20px}.arrangement,.experiment,.result-item{break-inside:avoid}.print-only{display:block}.stimulus{font-size:3rem}.route{font-size:.875rem}}
+</style></head><body><header><div class="brand">注意力的極限<span class="sample-tag">兩頁樣張 · 正文6與8</span></div><label><select id="jump" aria-label="選擇樣張"><option value="0">正文6 · 多工對照</option><option value="1">正文8 · 切換體驗</option></select></label></header><main><section class="slide" id="sample6"><ol class="route" aria-label="課程主線"><li class="read">選擇</li><li class="current" aria-current="step">分配</li><li>處理</li><li>回到生活</li></ol><p class="eyebrow">分配注意 / 兩種安排</p><h1>同時做，和來回做，是兩種不同安排</h1><p class="lead">「多工」可能同時進行，也可能來回切換。先分清楚，才知道怎麼比較。</p><p class="termline">多工（multitasking）常統稱兩種安排。分散注意力（divided attention）談兩項以上任務同時進行時的注意配置，不直接等於「分心」或「被打斷」。</p><div class="arrangements"><article class="arrangement same"><div class="arrangement-intro"><h2>同時進行<span class="eng">分散注意力 divided attention／雙重任務 dual task</span></h2><p>兩項工作在同一段時間持續進行。</p></div><div class="arrangement-content"><p class="scenario">教學例子：一邊讀課文、一邊聽同學說話。兩項工作在同一段時間進行，需要觀察每一項工作表現。</p><div class="timeline"><span class="track-label">任務A</span><div class="track"><span class="task full">讀課文</span></div><span class="track-label">任務B</span><div class="track"><span class="task listen full">聽同學說話</span></div></div><p class="axis"><span>時間較早</span><span>時間較晚</span></p><div class="compare"><strong>怎樣比較表現？</strong><br>把「單獨閱讀」和「邊聽邊讀」的閱讀理解相比；聽同學說話也要有單獨聽的基準。不能只看其中一件有沒有完成。</div></div></article><article class="arrangement switch"><div class="arrangement-intro"><h2>來回切換<span class="eng">任務切換 task switching</span></h2><p>當下處理的任務目標依序改變。</p></div><div class="arrangement-content"><p class="scenario">教學例子：先讀課文，改回訊息，再接回閱讀。當下的任務目標依次改變，不是兩項一直同時進行。</p><div class="timeline"><span class="track-label">當下任務</span><div class="track"><span class="task">讀課文</span><span class="task message">回訊息</span><span class="task">接回閱讀</span></div></div><p class="axis"><span>時間較早</span><span>時間較晚</span></p><div class="compare"><strong>怎樣比較表現？</strong><br>研究可比較換任務與重複同一任務時的表現；日常則可比較兩件事都完成後的時間與品質。</div></div></article></div><p class="takeaway">下一頁先看研究者如何觀察切換的代價，再輪到你體驗。時間軸只表示安排，長度不是研究數據。</p><p class="sources">來源：<a href="#ref-1" data-source="1" aria-label="查看來源 1">[1]</a><a href="#ref-4" data-source="4" aria-label="查看來源 4">[4]</a></p></section><section class="slide" id="sample8" hidden><ol class="route" aria-label="課程主線"><li class="read">選擇</li><li class="current" aria-current="step">分配</li><li>處理</li><li>回到生活</li></ol><p class="eyebrow">分配注意 / 任務切換體驗</p><h1>換規則時，你會慢下來嗎？</h1><p class="lead">同樣兩種判斷，規則排法不同，作答會有差嗎？</p><div class="intro-grid"><div class="instructions"><h2>看數字之前，先看規則</h2><p>你會看到一個數字及目前規則。奇偶規則問「奇數還是偶數」；大小規則問「比5小還是比5大」。例如7，在奇偶題答奇數，在大小題答大於5。</p><p>先做6題練習，熟悉兩種規則及兩個答案按鈕。桌機可按F或J，手機可直接點答案。</p></div><div class="rounds"><div class="round-card"><strong>分段輪</strong><p>先連做6題奇偶，再連做6題大小。</p></div><div class="round-card"><strong>交替輪</strong><p>每題換規則，奇偶與大小各6題。</p></div><p class="fine">兩輪匹配任務種類、題數、數字範圍及按鍵方式；改變的是規則安排。這是課堂教學改編，不是原始實驗重現。</p></div></div><div class="experiment"><div class="exp-top"><span id="trial-count">練習6題 · 每輪12題</span><span id="rule" class="rule">準備好再開始</span></div><div id="stimulus" class="stimulus" aria-live="polite" aria-atomic="true">—</div><div class="answers"><button id="answer-left" disabled><span id="left-label">左側答案</span><kbd>F</kbd></button><button id="answer-right" disabled><span id="right-label">右側答案</span><kbd>J</kbd></button></div><p id="status" class="status" aria-live="polite">先練習；說明與題間停頓不計入作答時間。</p><div class="actions"><button id="start" class="primary">開始練習</button><button id="continue" class="primary" hidden>開始這一輪</button><button id="skip">先跳過，看解讀</button></div></div><section id="results" class="results" aria-live="polite" hidden><h2>這次作答告訴你什麼？</h2><div id="result-grid" class="result-grid"></div><p id="interpret" class="interpret"></p></section><details><summary>想知道計分細節？</summary><p>兩輪各12題，排除5，匹配各規則的數字範圍與左右答案分布，先後順序隨機。每題最多5秒，時間為每題等待作答時間的加總，不含說明與題間停頓。兩輪均完整完成、無逾時、答對數相同且各至少10題，才解讀差值；這是教學門檻，不是常模。</p><p>即使安排匹配，仍不能排除練習、順序及操作的影響，一次差值不是研究效應的純估計。可跳過或重來；離頁、查看來源或切到背景會中止未完成的活動，資料只暫存於本頁記憶體，不上傳。</p></details><p class="sources">來源：<a href="#ref-4" data-source="4" aria-label="查看來源 4">[4]</a></p></section></main><footer><span id="page-label" class="page-label">正文6 · 多工對照</span><span class="keyboard-hint">左右鍵切換樣張 · 內容較長時可捲動</span><div class="nav"><button id="prev">上一張</button><button id="next">下一張</button></div></footer><dialog id="source-dialog" aria-labelledby="source-title"><h2 id="source-title">樣張使用的來源</h2><p class="fine">知識依據已確認的Wiki。原文需連網；樣張本身不需要網路。</p><div id="ref-1" class="source-entry"><h3>[1] Attention</h3><p>Frances Friedrich（2026，依來源建議書目）。Noba textbook series: Psychology. DEF publishers。開放教材，涵蓋選擇與分散注意。</p><p><a href="https://nobaproject.com/modules/attention" target="_blank" rel="noopener">閱讀原文</a></p><p class="fine">相關改寫署名Frances Friedrich／Noba，採CC BY-NC-SA 4.0。</p></div><div id="ref-4" class="source-entry"><h3>[4] Multitasking: Switching costs</h3><p>American Psychological Association（n.d.）。專業機構研究解說；研究故事若由本來源轉述，不表示另讀原始論文。</p><p><a href="https://www.apa.org/topics/research/multitasking" target="_blank" rel="noopener">閱讀原文</a></p></div><div class="actions"><button id="close-sources">返回原頁</button></div></dialog><noscript>此樣張的逐頁導覽與活動需要啟用JavaScript。</noscript><script>'use strict';
+const $=s=>document.querySelector(s),slides=[...document.querySelectorAll('.slide')];let current=0;
+const tasks={parity:{label:'判斷奇偶',left:'奇數',right:'偶數',correct:n=>n%2?0:1},magnitude:{label:'比5大或小',left:'小於5',right:'大於5',correct:n=>n<5?0:1}};
+function shuffle(a,rng=Math.random){a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(rng()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
+function makeRound(kind,rng=Math.random){const sets={parity:shuffle([1,2,3,6,7,8],rng),magnitude:shuffle([1,2,3,6,7,8],rng)};const rules=kind==='blocked'?[...Array(6).fill('parity'),...Array(6).fill('magnitude')]:Array.from({length:12},(_,i)=>i%2?'magnitude':'parity');return rules.map(rule=>({rule,n:sets[rule].pop()}))}
+function summarize(rows){const rounds=['blocked','mixed'].map(kind=>{const a=rows.filter(x=>x.kind===kind);return {kind,count:a.length,correct:a.filter(x=>x.status==='correct').length,wrong:a.filter(x=>x.status==='wrong').length,timeout:a.filter(x=>x.status==='timeout').length,total:a.reduce((sum,x)=>sum+x.rt,0)}});const eligible=rounds.every(x=>x.count===12&&x.timeout===0&&x.correct>=10)&&rounds[0].correct===rounds[1].correct;return {rounds,eligible,delta:eligible?rounds[1].total-rounds[0].total:null}}
+const game={phase:'intro',locked:true,timer:null,next:null,trials:[],i:0,rows:[],order:[],round:0,started:0,result:null};
+function stopTimers(){clearTimeout(game.timer);clearTimeout(game.next)}
+function answers(disabled){$('#answer-left').disabled=disabled;$('#answer-right').disabled=disabled}
+function stateText(text){$('#status').textContent=text}
+function resetResults(){game.result=null;$('#results').hidden=true;$('#result-grid').innerHTML='';$('#interpret').textContent=''}
+function abort(){if(!['practice','formal','between'].includes(game.phase))return;stopTimers();game.phase='aborted';game.locked=true;game.rows=[];resetResults();answers(true);$('#stimulus').textContent='—';$('#rule').textContent='已中止';$('#trial-count').textContent='未完成';$('#continue').hidden=true;stateText('這次活動已中止。回來後可重新開始，舊資料不會混入。')}
+function showPage(i){i=Math.max(0,Math.min(1,i));if(current===1&&i!==1)abort();current=i;slides.forEach((s,n)=>s.hidden=n!==i);$('#jump').value=String(i);$('#prev').disabled=i===0;$('#next').disabled=i===1;$('#page-label').textContent=i===0?'正文 6 · 多工對照':'正文 8 · 任務切換體驗';document.querySelector('main').scrollTop=0;history.replaceState(null,'',i===0?'#sample6':'#sample8')}
+function practice(){stopTimers();resetResults();game.rows=[];game.order=shuffle(['blocked','mixed']);game.round=0;game.i=0;game.phase='practice';game.trials=[{rule:'parity',n:3},{rule:'parity',n:6},{rule:'magnitude',n:2},{rule:'magnitude',n:8},{rule:'parity',n:7},{rule:'magnitude',n:4}];$('#start').textContent='重新開始';$('#continue').hidden=true;stateText('練習不計入結果；看清楚目前規則。');nextTrial()}
+function prepareRound(){game.phase='between';game.locked=true;answers(true);const kind=game.order[game.round];$('#rule').textContent='先讀規則';$('#trial-count').textContent=`第 ${game.round+1} 輪 / 2`;$('#stimulus').textContent=kind==='blocked'?'分段輪':'交替輪';stateText(kind==='blocked'?'這輪先做6題奇偶，再做6題大小。按下「開始這一輪」才計時。':'這輪每題換規則，奇偶與大小各6題。按下「開始這一輪」才計時。');$('#continue').hidden=false}
