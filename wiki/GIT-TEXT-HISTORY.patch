diff --git a/workflow/test_html.py b/workflow/test_html.py
new file mode 100644
index 0000000..bf284b8
--- /dev/null
+++ b/workflow/test_html.py
@@ -0,0 +1,105 @@
+"""Actual Chromium/file:// tests. Synthetic responses are never research data."""
+import argparse
+import json
+from pathlib import Path
+from playwright.sync_api import sync_playwright
+from run import ROOT,RUN,digest,now,save
+
+parser=argparse.ArgumentParser();parser.add_argument('--report',default='html-initial.json')
+parser.add_argument('--mode',choices=['file','memory-http'],default='file')
+args=parser.parse_args();checks=[];issues=[];screens=[];errors=[];requests=[]
+html=ROOT/'slides/index.html';data=json.loads((ROOT/'content/pages.json').read_text())
+def check(name,ok,detail=None):
+    checks.append(dict(name=name,result='pass' if ok else 'fail',detail=detail))
+    if not ok:issues.append(dict(id=f'H{len(issues)+1:02}',node=5,check=name,detail=detail))
+
+with sync_playwright() as p:
+    browser=p.chromium.launch(executable_path='/usr/bin/chromium',headless=True,args=['--no-sandbox'])
+    context=browser.new_context(offline=True,viewport={'width':1440,'height':900})
+    context.route('http://**/*',lambda route:route.abort())
+    context.route('https://**/*',lambda route:route.abort())
+    if args.mode=='memory-http':
+        context.route('http://localhost:31460/index.html',lambda route:route.fulfill(status=200,content_type='text/html; charset=utf-8',body=html.read_bytes()))
+    page=context.new_page()
+    page.on('pageerror',lambda e:errors.append(str(e)))
+    page.on('request',lambda req:requests.append(req.url) if req.url.startswith(('http://','https://')) and req.url!='http://localhost:31460/index.html' else None)
+    try:
+        page.goto(html.as_uri() if args.mode=='file' else 'http://localhost:31460/index.html');page.wait_for_selector('#P01:visible')
+        check('html_file_and_12_pages',html.exists() and page.locator('.slide').count()==12)
+        check('first_page_previous_disabled',page.locator('#prev').is_disabled())
+        page.keyboard.press('ArrowLeft');check('first_page_boundary',page.locator('#P01').is_visible())
+        for i in range(1,12):page.locator('#next').click()
+        check('next_navigation_all_pages',page.locator('#P12').is_visible())
+        check('last_page_next_disabled',page.locator('#next').is_disabled())
+        page.keyboard.press('ArrowRight');check('last_page_boundary',page.locator('#P12').is_visible())
+        page.keyboard.press('ArrowLeft');check('keyboard_navigation',page.locator('#P11').is_visible())
+        # All views: detect actual horizontal overflow; vertical content can scroll inside main.
+        for width,height in [(1440,900),(1024,768),(390,844),(800,600)]:
+            page.set_viewport_size(dict(width=width,height=height))
+            for i in range(12):
+                page.select_option('#jump',str(i))
+                check(f'title_{width}_P{i+1:02}',page.locator('.slide:visible h1').inner_text()==data['pages'][i]['title'])
+                bad=page.evaluate('''() => [...document.querySelectorAll('.slide:not([hidden]) *')].filter(e=>{const r=e.getBoundingClientRect();return r.width>0&&(r.left < -1 || r.right > innerWidth+1)}).map(e=>({tag:e.tagName,class:e.className,text:e.textContent.slice(0,60)}))''')
+                check(f'horizontal_bounds_{width}_P{i+1:02}',not bad,bad)
+                check(f'footer_visible_{width}_P{i+1:02}',page.locator('footer').bounding_box()['y']+page.locator('footer').bounding_box()['height']<=height+1)
+                check(f'no_truncated_text_{width}_P{i+1:02}',page.evaluate('''()=>[...document.querySelectorAll('.slide:not([hidden]) h1,.slide:not([hidden]) p,.slide:not([hidden]) .card')].every(e=>e.scrollWidth<=e.clientWidth+1 && e.scrollHeight<=e.clientHeight+1)'''))
+                shot=RUN/f'screens/{width}-P{i+1:02}.png';shot.parent.mkdir(exist_ok=True)
+                page.screenshot(path=str(shot));screens.append(str(shot.relative_to(ROOT)))
+        page.set_viewport_size(dict(width=1440,height=900))
+        page.select_option('#jump','2');page.locator('#P03 [data-reference="5"]').click()
+        check('citation_opens_reference_page',page.locator('#P12').is_visible() and page.locator('#ref-5').evaluate('(e)=>e===document.activeElement'))
+        refs=page.locator('#P12 .ref-url').evaluate_all('(els)=>els.map(e=>e.href)')
+        check('reference_urls_match_wiki_metadata',refs==[r['url'] for r in data['references']])
+        check('all_local_anchor_targets_exist',page.evaluate('''()=>[...document.querySelectorAll('a[href^="#"]')].every(a=>document.getElementById(a.getAttribute('href').slice(1)))'''))
+        check('all_reviewed_text_preserved',all(page.locator('#'+x['id']).inner_text().find(x['lead'])>=0 and all(c['body'] in page.locator('#'+x['id']).inner_text() for c in x['cards']) for x in data['pages']))
+        check('no_runtime_network_requests',len(requests)==0,requests)
+        check('no_external_assets',page.evaluate('''()=>!document.querySelector('script[src],link[rel="stylesheet"],img[src^="http"],iframe,video,audio')'''))
+        # Pure task design/scoring checks exercise actual embedded production functions.
