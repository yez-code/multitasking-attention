@@ -0,0 +1,40 @@
+"""Control tests use temporary synthetic states, not real correction rounds."""
+import tempfile
+import unittest
+from pathlib import Path
+from run import Gate, save, digest
+
+class Gates(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.d = Path(self.temp.name)
+        self.artifact = self.d/'outline.json'
+        self.artifact.write_text('{}')
+        save(self.d/'state.json', dict(phase='waiting_outline', repair_round=0,
+             repair_open=False, approvals={}, outline_hash=digest(self.artifact)))
+        self.g = Gate(self.d)
+
+    def test_missing_approval_blocks_content(self):
+        with self.assertRaises(ValueError): self.g.require_outline(self.artifact)
+
+    def test_changed_outline_invalidates_approval(self):
+        self.g.approve('outline', self.artifact, 'synthetic test approval, not user approval')
+        self.artifact.write_text('{"changed":true}')
+        with self.assertRaises(ValueError): self.g.require_outline(self.artifact)
+
+    def test_shared_budget_and_no_nested_retry(self):
+        report=self.d/'report.json'; report.write_text('{"synthetic":true}')
+        for _ in range(3):
+            self.g.begin_repair('content', report)
+            with self.assertRaises(ValueError): self.g.begin_repair('layout', report)
+            self.g.finish_repair(report, False)
+        with self.assertRaises(ValueError): self.g.begin_repair('outline', report)
+        self.assertEqual(self.g.s['repair_round'],3)
+        self.assertEqual(self.g.s['phase'],'stopped_limit')
+
+    def test_final_cannot_pass_unverified(self):
+        self.g.s['phase']='waiting_final'
+        with self.assertRaises(ValueError): self.g.approve('final',self.artifact,'test')
+
+if __name__ == '__main__': unittest.main()

