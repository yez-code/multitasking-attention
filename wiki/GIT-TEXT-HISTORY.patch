+'use strict';
+const pages=[...document.querySelectorAll('.slide')];
+const main=document.querySelector('main'), select=document.querySelector('#jump');
+let pageIndex=0;
+const COLORS=[{word:'紅',css:'#bc293c'},{word:'藍',css:'#245ac7'},{word:'綠',css:'#24714b'},{word:'紫',css:'#8539af'}];
+function shuffle(items,rng=Math.random){const a=items.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(rng()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
+function makeTrials(rng=Math.random){const a=[];for(let ink=0;ink<4;ink++){for(let n=0;n<3;n++){a.push({ink,word:ink,compatible:true});a.push({ink,word:(ink+n+1)%4,compatible:false})}}return shuffle(a,rng)}
+function summarize(rows){const groups=[true,false].map(c=>{const all=rows.filter(r=>r.compatible===c),valid=all.filter(r=>r.status==='correct');return {valid:valid.length,wrong:all.filter(r=>r.status==='wrong').length,timeout:all.filter(r=>r.status==='timeout').length,mean:valid.length?valid.reduce((s,r)=>s+r.rt,0)/valid.length:null}});const sufficient=groups.every(g=>g.valid>=6);return {groups,sufficient,delta:sufficient?groups[1].mean-groups[0].mean:null}}
+const game={active:false,locked:true,rows:[],trials:[],i:0,timer:null,nextTimer:null,started:0,result:null};
+const $=s=>document.querySelector(s), answers=[...document.querySelectorAll('[data-answer]')];
+function stopTimers(){clearTimeout(game.timer);clearTimeout(game.nextTimer)}
+function disableAnswers(value){answers.forEach(b=>b.disabled=value)}
+function abortGame(){if(!game.active)return;stopTimers();game.active=false;game.locked=true;game.rows=[];game.result=null;disableAnswers(true);$('#stimulus').textContent='—';$('#game-status').textContent='這輪已中止';$('#feedback').textContent='離開或切換到背景會中止本輪；可返回後重新開始。';$('#start').textContent='重新開始';renderResults()}
+function showPage(i){i=Math.max(0,Math.min(pages.length-1,i));if(pageIndex===8&&i!==8)abortGame();pageIndex=i;pages.forEach((p,n)=>p.hidden=n!==i);select.value=String(i);$('#prev').disabled=i===0;$('#next').disabled=i===pages.length-1;$('#page-count').textContent=`${String(i+1).padStart(2,'0')} / ${pages.length}`;$('#progress-fill').style.width=`${(i+1)/pages.length*100}%`;main.scrollTop=0;history.replaceState(null,'',`#P${String(i+1).padStart(2,'0')}`);document.title=`${i+1}/${pages.length} · 注意力的極限`;if(i===9)renderResults()}
+function startGame(){stopTimers();game.active=true;game.locked=true;game.rows=[];game.result=null;game.i=0;const practice=COLORS.map((_,i)=>({ink:i,word:i%2?i:(i+1)%4,compatible:!!(i%2),practice:true}));game.trials=[...practice,...makeTrials().map(t=>({...t,practice:false}))];$('#start').textContent='重新開始';$('#feedback').textContent='請回答墨色；練習題不計入正式結果。';renderResults();nextTrial()}
+function nextTrial(){if(!game.active)return;if(game.i===game.trials.length){game.active=false;game.locked=true;disableAnswers(true);game.result=summarize(game.rows);$('#stimulus').textContent='完成';$('#stimulus').style.color='var(--ink)';$('#game-status').textContent='24 題正式題已完成';$('#feedback').textContent='前往下一頁查看本輪結果；這不是個人能力診斷。';renderResults();return}const t=game.trials[game.i];$('#game-status').textContent=t.practice?`練習 ${game.i+1} / 4`:`正式題 ${game.i-3} / 24`;$('#stimulus').textContent=COLORS[t.word].word;$('#stimulus').style.color=COLORS[t.ink].css;game.started=performance.now();game.locked=false;disableAnswers(false);game.timer=setTimeout(()=>respond(null),5000)}
+function respond(answer){if(!game.active||game.locked||pageIndex!==8)return;game.locked=true;clearTimeout(game.timer);disableAnswers(true);const t=game.trials[game.i];const elapsed=performance.now()-game.started;const status=answer===null||elapsed>=5000?'timeout':answer===t.ink?'correct':'wrong';const rt=Math.min(elapsed,5000);if(!t.practice)game.rows.push({...t,status,rt});$('#feedback').textContent=t.practice?(status==='correct'?'練習：答對了。':status==='timeout'?'練習：逾時，請在 5 秒內依墨色作答。':`練習：墨色是「${COLORS[t.ink].word}」，不要讀字義。`):'已記錄本題。';game.i++;game.nextTimer=setTimeout(nextTrial,260)}
+function renderResults(){const el=$('#results');if(!game.result){el.innerHTML='<p class="results-empty">目前沒有已完成的一輪資料。可回上一頁體驗，也可直接閱讀下方的解讀原則。</p>';return}const s=game.result;el.innerHTML=s.groups.map((g,i)=>`<div class="metric">${i===0?'一致':'不一致'}條件<b>${g.mean===null?'—':Math.round(g.mean)+' ms'}</b><small>有效 ${g.valid} / 12 題<br>錯誤 ${g.wrong} 題 · 逾時 ${g.timeout} 題</small></div>`).join('')+`<div class="delta">${s.sufficient?`本輪差值：${Math.round(s.delta)} ms<br><small>正、零或負只描述本輪資料，不判定個人能力。</small>`:'資料不足：任一條件有效題數少於 6 題，不提供差值解讀。'}</div>`}
+$('#prev').addEventListener('click',()=>showPage(pageIndex-1));$('#next').addEventListener('click',()=>showPage(pageIndex+1));select.addEventListener('change',()=>showPage(Number(select.value)));$('#start').addEventListener('click',startGame);$('#skip').addEventListener('click',()=>showPage(9));answers.forEach(b=>b.addEventListener('click',()=>respond(Number(b.dataset.answer))));
+document.addEventListener('keydown',e=>{if(e.repeat||e.altKey||e.ctrlKey||e.metaKey||e.target.matches('select,input,textarea'))return;if(game.active&&pageIndex===8&&/^[1-4]$/.test(e.key)){e.preventDefault();respond(Number(e.key)-1);return}if(e.key==='ArrowRight'){e.preventDefault();showPage(pageIndex+1)}if(e.key==='ArrowLeft'){e.preventDefault();showPage(pageIndex-1)}});
+document.addEventListener('visibilitychange',()=>{if(document.hidden)abortGame()});
+document.querySelectorAll('[data-reference]').forEach(a=>a.addEventListener('click',e=>{e.preventDefault();showPage(11);const target=document.getElementById('ref-'+a.dataset.reference);target.focus();target.scrollIntoView({block:'center'})}));
+window.__attention={makeTrials,summarize,getState:()=>({active:game.active,locked:game.locked,index:game.i,rows:game.rows.length,trial:game.trials[game.i],result:game.result})};
+const initial=Number((location.hash.match(/^#P(\d{2})$/)||[])[1])-1;showPage(Number.isFinite(initial)?initial:0);
