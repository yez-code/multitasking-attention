+"""AI-assisted Graph control. Running this file executes nodes 1–3 only."""
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+from datetime import datetime
+from zoneinfo import ZoneInfo
+
+ROOT = Path(__file__).resolve().parents[1]
+RUN = ROOT / 'records/runs/attention-001'
+
+def now():
+    return datetime.now(ZoneInfo('Asia/Taipei')).isoformat()
+
+def digest(p):
+    return hashlib.sha256(Path(p).read_bytes()).hexdigest()
+
+def save(p, obj):
+    p = Path(p)
+    p.parent.mkdir(parents=True, exist_ok=True)
+    tmp = p.with_suffix(p.suffix + '.tmp')
+    tmp.write_text(json.dumps(obj, ensure_ascii=False, indent=2) + '\n')
+    tmp.replace(p)
+
+def commit():
+    return subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip()
+
+class Gate:
+    def __init__(self, directory):
+        self.d = Path(directory)
+        self.p = self.d / 'state.json'
+        self.s = json.loads(self.p.read_text())
+
+    def event(self, node, result, **fields):
+        self.s['updated_at'] = now()
+        save(self.p, self.s)
+        event = dict(time=now(), node=node, result=result, git_commit=commit(),
+                     repair_round=self.s['repair_round'], remaining=3-self.s['repair_round'],
+                     errors=[], correction=None, retest=None, **fields)
+        with (self.d / 'events.jsonl').open('a') as f:
+            f.write(json.dumps(event, ensure_ascii=False)+'\n')
+
+    def approve(self, stage, artifact, user_message):
+        if not user_message.strip():
+            raise ValueError('Explicit user approval text required')
+        if self.s['phase'] != 'waiting_'+stage:
+            raise ValueError('Not at this approval gate')
+        if stage == 'outline' and digest(artifact) != self.s['outline_hash']:
+            raise ValueError('Outline changed since validation')
+        if stage == 'final' and (not self.s.get('all_required_checks_passed') or
+                                  digest(artifact) != self.s.get('validated_html_hash')):
+            raise ValueError('Final artifact lacks current required validation')
+        self.s['approvals'][stage] = dict(time=now(), artifact_hash=digest(artifact),
+                                          user_message=user_message)
+        self.s['phase'] = 'node4_ready' if stage == 'outline' else 'completed'
+        self.event(3 if stage == 'outline' else 6, 'approved', stage=stage)
+
+    def require_outline(self, artifact):
+        a = self.s['approvals'].get('outline')
+        if not a or a['artifact_hash'] != digest(artifact):
+            raise ValueError('Current outline lacks human approval')
+
+    def begin_repair(self, issue_type, report, affects_outline=False):
+        if self.s.get('repair_open'):
+            raise ValueError('Finish current correction and retest before another round')
+        if self.s['repair_round'] >= 3:
+            self.s['phase'] = 'stopped_limit'
+            self.event('loop', 'blocked', reason='Three repair rounds exhausted')
+            raise ValueError('No repair rounds remain')
+        target = {'data':1, 'coverage':2, 'outline':3, 'content':4,
+                  'citation':4, 'layout':5, 'interaction':5}[issue_type]
+        if not Path(report).is_file():
+            raise ValueError('Existing issue report required')
+        self.s['repair_round'] += 1
+        self.s['repair_open'] = True
+        self.s['approvals'].pop('final', None)
+        if affects_outline or target == 3:
+            self.s['approvals'].pop('outline', None)
+        self.s['phase'] = 'repair_node'+str(target)
+        self.event(target, 'repair_started', issue_type=issue_type,
+                   report_hash=digest(report), return_node=target)
+
+    def finish_repair(self, report, passed):
+        if not self.s.get('repair_open') or not Path(report).is_file():
+            raise ValueError('Open repair and actual retest report required')
+        self.s['repair_open'] = False
+        self.s['phase'] = ('checks_passed_pending_gate' if passed else
+                           'stopped_limit' if self.s['repair_round'] == 3 else 'repair_needed')
+        self.event('loop', 'pass' if passed else 'fail', retest_report_hash=digest(report))
+
+def initial():
+    if RUN.exists():
+        raise SystemExit('Existing run: refusing overwrite or counter reset')
+    RUN.mkdir(parents=True)
+    save(RUN/'state.json', dict(run_id=RUN.name, phase='node1', repair_round=0,
+                               repair_open=False, approvals={}, baseline_commit=commit()))
+    g = Gate(RUN)
+    inputs = sorted((ROOT/'wiki').glob('*.md')) + sorted((ROOT/'sources/notes').glob('*.md'))
+    frozen = {str(p.relative_to(ROOT)):digest(p) for p in inputs}
+    claims = {}
+    for line in (ROOT/'wiki/claims.md').read_text().splitlines():
+        if line.startswith('| K'):
+            cols = [c.strip() for c in line.split('|')[1:-1]]
+            claims[cols[0]] = dict(statement=cols[1], kind=cols[2], source_locator=cols[3])
+    save(RUN/'evidence.json', dict(time=now(), input_hashes=frozen, claims=claims,
+                                  method='Read existing Wiki; no external knowledge retrieval'))
+    g.event(1, 'pass', checks=['Wiki and seven notes read', 'Claim rows and file hashes retained'])
+    outline_path = ROOT/'content/outline.json'
+    outline = json.loads(outline_path.read_text())
+    coverage = []
+    for concept in outline['required_concepts']:
+        keys = concept['claims']
+        coverage.append(dict(concept=concept['name'], claims=keys,
+                             result='pass' if keys and all(k in claims for k in keys) else 'fail',
+                             semantic_basis=concept['basis']))
+    ok = all(r['result']=='pass' for r in coverage)
+    save(RUN/'coverage.json', dict(time=now(), node=2, result='pass' if ok else 'fail',
+         coverage_ratio=sum(r['result']=='pass' for r in coverage)/len(coverage),
+         rows=coverage, semantic_review='AI read Wiki and mapped each necessary concept; no independent review yet'))
+    g.event(2, 'pass' if ok else 'fail', checks=['All necessary concepts mapped to supported Wiki claims'])
+    if not ok:
+        g.s['phase']='blocked_coverage';g.event(2,'blocked',return_node=1);return
+    pages = outline['pages']
+    counts = {}
+    for p in pages:
+        counts[p['concept_group']] = counts.get(p['concept_group'],0)+1
+    checks = {'page_count_8_15':8<=len(pages)<=15,
+              'max_3_per_concept':all(n<=3 for n in counts.values()),
+              'claims_resolve':all(k in claims for p in pages for k in p['claims']),
+              'one_game':sum(p.get('activity',False) for p in pages)==1,
+              'unique_page_ids':len({p['id'] for p in pages})==len(pages),
+              'wiki_unchanged':all(digest(ROOT/p)==h for p,h in frozen.items())}
+    passed=all(checks.values())
+    save(RUN/'outline-check.json', dict(time=now(),node=3,checks=checks,
+                                      result='pass' if passed else 'fail',page_count=len(pages),group_counts=counts))
+    g.s['outline_hash']=digest(outline_path)
+    g.s['phase']='waiting_outline' if passed else 'blocked_outline'
+    g.event(3,'waiting' if passed else 'fail', checks=checks,
+            artifact='content/outline.json',approval=False,
+            not_run=['node4_independent_review','node5_html','node6_browser','final_acceptance'])
+
+if __name__ == '__main__':
+    initial()
