+ arr.append('<article class="arrangement '+kind+'"><div class="arrangement-intro"><h2>'+title+'<span class="eng">'+eng+'</span></h2><p>'+('兩項工作在同一段時間持續進行。' if kind=='same' else '當下處理的任務目標依序改變。')+'</p></div><div class="arrangement-content"><p class="scenario">'+e(p6['blocks'][j]['text'])+'</p>'+track(kind)+'<p class="axis"><span>時間較早</span><span>時間較晚</span></p><div class="compare"><strong>怎樣比較表現？</strong><br>'+e(p6['blocks'][j+1]['text'])+'</div></div></article>')
