@@ -0,0 +1,45 @@
+"""Check Wiki structure and traceability; does not judge scientific truth."""
+from pathlib import Path
+import json
+import re
+
+root = Path(__file__).resolve().parents[1]
+expected = {'C01', 'C02', 'C04', 'C05', 'C06', 'C07', 'C08'}
+errors = []
+notes = list((root / 'sources/notes').glob('*.md'))
+if {p.stem for p in notes} != expected:
+    errors.append('Source notes differ from approved seven sources')
+for p in notes:
+    text = p.read_text()
+    for field in ['取用日', 'URL', '已讀範圍', '授權', '定位']:
+        if field not in text:
+            errors.append(f'{p.name}: missing {field}')
+links = 0
+for p in root.rglob('*.md'):
+    if '.git' in p.parts:
+        continue
+    for target in re.findall(r'\]\(([^)]+)\)', p.read_text()):
+        if target.startswith(('https://', 'http://', '#')):
+            continue
+        links += 1
+        if not (p.parent / target.split('#')[0]).exists():
+            errors.append(f'{p.relative_to(root)}: broken link {target}')
+claims = (root / 'wiki/claims.md').read_text()
+claim_ids = set(re.findall(r'^\| (K\d+) \|', claims, re.M))
+if claim_ids != {f'K{i:02}' for i in range(1, 15)}:
+    errors.append('Expected K01–K14 claim rows')
+for p in (root / 'wiki').glob('*.md'):
+    for key in re.findall(r'\bK\d{2}\b', p.read_text()):
+        if key not in claim_ids:
+            errors.append(f'{p.name}: unknown claim {key}')
+manifest = json.loads((root / 'records/ingest/acquisition.json').read_text())
+if {r['id'] for r in manifest} != expected:
+    errors.append('Acquisition manifest does not match approved sources')
+for row in manifest:
+    if row.get('status') == 'retrieved' and row.get('bytes', 0) < 1000:
+        errors.append(f"{row['id']}: suspiciously small download; verify actual content")
+result = {'source_notes': len(notes), 'claim_rows': len(claim_ids),
+          'local_links_checked': links, 'errors': errors,
+          'scope': 'Structure and references only; semantic support manually reviewed'}
+print(json.dumps(result, ensure_ascii=False, indent=2))
+raise SystemExit(bool(errors))
