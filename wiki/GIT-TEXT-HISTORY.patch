+def track(kind):
+ if kind=='same':return '<div class="timeline"><span class="track-label">任務A</span><div class="track"><span class="task full">讀課文</span></div><span class="track-label">任務B</span><div class="track"><span class="task listen full">聽同學說話</span></div></div>'
+ return '<div class="timeline"><span class="track-label">當下任務</span><div class="track"><span class="task">讀課文</span><span class="task message">回訊息</span><span class="task">接回閱讀</span></div></div>'
+arr=[]
