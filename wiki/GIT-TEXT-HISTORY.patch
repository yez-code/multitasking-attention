+"""Resume the existing run; independent review and browser tools remain external agents."""
+import argparse
+import json
+from pathlib import Path
+from run import Gate, ROOT, RUN, digest, save
+
+def require_review(report):
+    g=Gate(RUN);g.require_outline(ROOT/'content/outline.json')
+    r=json.loads(Path(report).read_text())
+    if r.get('result') != 'pass' or r.get('issues'):
+        raise ValueError('Independent review must pass without unresolved issues')
+    if r.get('context_mode') != 'fork_turns=none' or not r.get('reviewer_id'):
+        raise ValueError('Isolated reviewer provenance required')
+    if r.get('pages_sha256') != digest(ROOT/'content/pages.json'):
+        raise ValueError('Reviewed content version does not match current pages')
+    for p,h in json.loads((RUN/'evidence.json').read_text())['input_hashes'].items():
+        if digest(ROOT/p)!=h:raise ValueError('Frozen Wiki changed; approval required')
+    return g,r
+
+def accept_review(report):
+    g,r=require_review(report)
+    g.s['content_hash']=r['pages_sha256'];g.s['review_report_hash']=digest(report)
+    g.s['phase']='node5_ready'
+    g.event(4,'pass',reviewer_id=r['reviewer_id'],context_mode=r['context_mode'],
+            artifact_hash=r['pages_sha256'],report=str(Path(report).resolve().relative_to(ROOT)))
+
+def accept_validation(report):
+    g=Gate(RUN);g.require_outline(ROOT/'content/outline.json')
+    r=json.loads(Path(report).read_text())
+    if g.s.get('content_hash')!=digest(ROOT/'content/pages.json'):
+        raise ValueError('Content changed since independent review')
+    if r.get('html_sha256')!=digest(ROOT/'slides/index.html') or r.get('result')!='pass':
+        raise ValueError('Current HTML has not passed all required checks')
+    if not r.get('browser_executed') or r.get('unverified') or r.get('issues'):
+        raise ValueError('Required validation is incomplete')
+    if g.s.get('repair_open'):g.finish_repair(report,True)
+    g.s['all_required_checks_passed']=True
+    g.s['validated_html_hash']=r['html_sha256'];g.s['phase']='waiting_final'
+    g.event(6,'waiting',report=str(Path(report).resolve().relative_to(ROOT)),
+            html_sha256=r['html_sha256'],reason='Human final acceptance required')
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser();parser.add_argument('action',choices=['review','validation'])
+    parser.add_argument('report');args=parser.parse_args()
+    (accept_review if args.action=='review' else accept_validation)(args.report)

