mplate-columns:220px minmax(0,1fr);gap:28px}.research-sidebar{background:var(--pale);padding:24px;border-radius:10px;align-self:start}.research-sidebar strong{display:block;font-size:2.5rem;color:var(--blue)}.research-story .block-stack .text-block{background:transparent;border-bottom:1px solid var(--line);border-radius:0;padding:0 0 20px}.origin-pair{display:grid;grid-template-columns:280px minmax(0,1fr);gap:28px;align-items:start}.color-demonstration{padding:28px;background:var(--pale);border-radius:12px;text-align:center}.color-demonstration .word{display:block;font-size:5rem;line-height:1.6;font-weight:800;color:#245ac7;background:white;border-radius:8px}.color-demonstration p{font-size:1rem;line-height:1.9}.result-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:28px;align-items:start}.result-layout .results{margin:0;max-width:none}.result-layout .result-grid{grid-template-columns:minmax(0,1fr)}.reading-results .block-stack{margin-top:24px;grid-template-columns:repeat(3,minmax(0,1fr))}.integration .chapter-node h2{color:var(--blue)}.applications{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}.applications article{padding:24px;border:1px solid var(--line);border-radius:10px}.applications article:last-child{grid-column:1/-1;background:var(--soft)}.applications p{margin:0;line-height:1.95}.prediction{max-width:980px}.choice-buttons{display:flex;gap:12px;flex-wrap:wrap;margin:20px 0}.reveal{padding:22px 26px;border-left:4px solid var(--blue);background:var(--pale);line-height:1.95;margin:24px 0}.reveal[hidden]{display:none}.source-list{display:grid;gap:18px;list-style:none;padding:0;margin:24px 0}.source-list li{border-top:1px solid var(--line);padding:18px 0;overflow-wrap:anywhere;line-height:1.95}.source-list h2{font-size:1rem}.source-list p{margin:0}.source-return{margin-bottom:20px}.stroop-board .answers{grid-template-columns:repeat(4,minmax(0,1fr));max-width:700px}.stroop-board .answers button{font-size:1.05rem;padding:14px 5px}.main-label{max-width:40%}.stat-empty{font-size:1rem;color:var(--muted);line-height:1.95}.instruction-summary{font-size:1rem;background:var(--soft);padding:18px 22px;border-radius:10px;line-height:1.95}.game-view{max-width:1100px}.game-view .experiment{margin-top:22px}.result-link[hidden]{display:none}.source-list a{overflow-wrap:anywhere}.sr-only{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap} @media(max-width:900px){.chapter-map,.study-grid,.reading-results .block-stack{grid-template-columns:minmax(0,1fr)}.listening,.research-story,.origin-pair,.result-layout{grid-template-columns:minmax(0,1fr)}.research-sidebar{display:flex;gap:20px;align-items:center}.origin-pair .color-demonstration{max-width:400px}.key-stat strong{font-size:3rem}.main-label{max-width:46%}}@media(max-width:600px){.misconceptions,.applications{grid-template-columns:minmax(0,1fr)}.applications article:last-child{grid-column:auto}.hero{padding-top:8px}.hero .lead{font-size:1.15rem}.key-stat{align-items:flex-start;flex-direction:column;gap:5px}.key-stat strong{font-size:3.5rem}.stroop-board .answers{gap:6px}.stroop-board .answers button{font-size:1rem}.source-return{max-width:100%}.result-layout .result-grid{grid-template-columns:minmax(0,1fr)}} @media print{.slide{break-after:page}.chapter-map,.study-grid,.result-layout,.origin-pair,.research-story,.listening,.reading-results .block-stack,.applications,.misconceptions{display:block}.text-block,.study-step,.chapter-node,.applications article{margin:12px 0;break-inside:avoid}.research-sidebar{margin-bottom:20px}.choice-buttons{display:none}.reveal[hidden]{display:block}.sources a{color:var(--ink)}.results[hidden]{display:block}.experiment{box-shadow:none}a{overflow-wrap:anywhere}}
-</style></head><body><header><div class="brand">注意力的極限<span class="sample-tag">選擇 · 分配 · 處理</span></div><label><select id="jump" aria-label="跳到投影片"><option value="0">封面</option><option value="1">1 · 你真的看到眼前的一切嗎？</option><option value="2">2 · 注意力，是把有限處理能力用在哪裡？</option><option value="3">3 · 吵雜餐廳裡，你為何仍能跟著同學說話？</option><option value="4">4 · 數對傳球，為什麼仍可能漏看意外人物？</option><option value="5">5 · 漏看一次，不代表眼睛壞了</option><option value="6">6 · 同時做，和來回做，是兩種不同安排</option><option value="7">7 · 換一件事，其實也要付出時間？</option><option value="8">8 · 換規則時，你會慢下來嗎？</option><option value="9">9 · 比較快慢之前，先看兩輪做得如何</option><option value="10">10 · 只想看墨色，為什麼字義也來干擾？</option><option value="11">11 · 這次請回答顏色，不要讀字</option><option value="12">12 · 一個差值，能告訴你什麼？</option><option value="13">13 · 選擇、分配、處理，其實問的是同一段生活</option><option value="14">14 · 把注意力原理變成讀書與駕駛的選擇</option><option value="15">來源</option></select></label></header><main><section class="slide" data-layout="cover" id="cover" hidden><ol class="route" aria-label="課程主線"><li>選擇</li><li>分配</li><li>處理</li><li>回到生活</li></ol><p class="eyebrow">注意力的極限</p><h1>封面：你以為自己注意到了多少？</h1><p class="lead">從「我一定看得到」開始，重新認識注意力。</p><p class="content-p">這份課程用選擇、分配、處理三個問題，帶你理解注意力的極限，最後回到讀書與駕駛。你可以先預測，再看研究與做兩個短體驗。</p><div class="hero"><p class="spotlight">選擇要看什麼；分配怎麼做事；處理哪些訊息會干擾。</p><div class="chapter-map"><div class="chapter-node"><h2>選擇</h2><p>資訊太多，先優先理解其中一部分。</p></div><div class="chapter-node"><h2>分配</h2><p>多項任務是同時做，還是來回切換？</p></div><div class="chapter-node"><h2>處理</h2><p>選好目標後，無關資訊仍可能干擾反應。</p></div></div><button class="primary" data-go="1">開始閱讀</button></div></section><section class="slide" data-layout="prediction" id="p01" hidden><ol class="route" aria-label="課程主線"><li class="current" aria-current="step">選擇</li><li>分配</li><li>處理</li><li>回到生活</li></ol><p class="eyebrow">選擇</p><h1>你真的看到眼前的一切嗎？</h1><p class="lead">你很確定，自己不會漏掉明顯的事嗎？</p><p class="content-p">想像你在車站找出口，熟人在旁邊揮手。你覺得自己一定會注意到他嗎？先選一個直覺答案，再展開說明。</p><div class="prediction"><article class="text-block"><h2>先猜</h2><p>我覺得會／不一定。這裡只記錄你的預測，不給能力分數。</p></article><div class="choice-buttons"><button data-reveal="prediction-reveal">我覺得會</button><button data-reveal="prediction-reveal">不一定</button></div><div id="prediction-reveal" class="reveal" hidden><article class="text-block"><h2>揭曉</h2><p>專心找出口時，仍可能沒有察覺熟人。眼前可見的事物，不保證已被你注意到；後面的傳球研究會把這個問題放進可檢查的任務。</p></article></div></div><p class="closing">車站情境是教學例子，不是本課已對你做過的實驗。</p><p class="sources">來源：<a href="#ref-5" data-source="5">[5]</a></p></section><section class="slide" data-layout="concept-map" id="p02" hidden><ol class="route" aria-label="課程主線"><li class="current" aria-current="step">選擇</li><li>分配</li><li>處理</li><li>回到生活</li></ol><p class="eyebrow">選擇</p><h1>注意力，是把有限處理能力用在哪裡？</h1><p class="lead">資訊很多時，先決定要把處理能力用在哪裡。</p><p class="content-p">注意力（attention）涉及在有限處理能力下選擇資訊。這裡把全課整理成三個提問，幫你理解同一個生活情境。</p><div class="chapter-map "><article class="chapter-node"><h2>選擇：先看哪些？</h2><p>讀課文時，哪一段資訊是現在要理解的目標？</p></article><article class="chapter-node"><h2>分配：多件事怎麼安排？</h2><p>要同時聽別人說話，還是停下閱讀再回訊息？</p></article><article class="chapter-node"><h2>處理：什麼會干擾反應？</h2><p>即使只想看墨色，熟悉字義也可能影響答案。</p></article></div><aside class="reader-example"><h2>教學類比</h2><p>像書桌放了許多資料，你先挑一份細讀；其他資料仍在，不等於都已理解。</p></aside><p class="closing">三段是理解問題的視角，不表示大腦必須依此順序運作。</p><p class="sources">來源：<a href="#ref-1" data-source="1">[1]</a></p></section><section class="slide" data-layout="listening-case" id="p03" hidden><ol class="route" aria-label="課程主線"><li class="current" aria-current="step">選擇</li><li>分配</li><li>處理</li><li>回到生活</li></ol><p class="eyebrow">選擇</p><h1>吵雜餐廳裡，你為何仍能跟著同學說話？</h1><p class="lead">注意力能跟著一段對話，不代表其他聲音消失了。</p><p class="content-p">選擇性注意力（selective attention）是在多種資訊中優先處理一部分、忽略干擾的能力。白話說，就是決定現在要仔細理解誰。</p><div class="listening"><article class="text-block"><h2>餐廳裡的例子</h2><p>你跟著面前同學說話，隔壁桌的聲音仍在，卻不一定能逐句重述。</p></article><div class="block-stack"><article class="text-block"><h2>人們怎麼研究？</h2><p>Noba教材介紹Cherry（1953）、Moray（1959）等雙耳分聽（dichotic listening）研究：兩耳聽不同訊息，跟讀其中一耳，再檢查可報告的內容。</p></article><article class="text-block"><h2>這發現了什麼？</h2><p>人通常能說出跟讀內容；對未注意的一耳，往往較能報告聲音特徵，而非完整意思。</p></article></div></div><aside class="reader-example"><h2>雞尾酒會效應 cocktail party effect</h2><p>複雜聲音中能跟隨特定對話，某些有意義線索仍可能吸引注意；不是每次都一定聽見自己的名字。</p></aside><p class="closing">研究依Noba教材轉述；不能由此斷言未注意訊息完全沒有加工。</p><p class="sources">來源：<a href="#ref-1" data-source="1">[1]</a></p></section><section class="slide" data-layout="study-sequence" id="p04" hidden><ol class="route" aria-label="課程主線"><li class="current" aria-current="step">選擇</li><li>分配</li><li>處理</li><li>回到生活</li></ol><p class="eyebrow">選擇</p><h1>數對傳球，為什麼仍可能漏看意外人物？</h1><p class="lead">數著傳球，仍可能錯過畫面裡的意外人物。</p><p class="content-p">非注意盲視（inattentional blindness）是注意投入別處時，沒有察覺眼前可見物件的現象。白話說，看到畫面不代表察覺畫面裡每件事。</p><div class="key-stat"><strong>46%</strong><span>192人、跨16個條件，未察覺意外事件的比例；不是所有版本的固定比例。</span></div><div class="study-grid"><article class="study-step"><h2>問題從哪裡來？</h2><p>Daniel J. Simons與Christopher F. Chabris在1999年承接選擇性觀看研究，問任務難度與意外物件特徵如何影響察覺。</p></article><article class="study-step"><h2>怎麼做？</h2><p>觀察者追蹤黑白隊伍中的指定一隊並計數傳球；有不同計數難度、影片形式及大猩猩／撐傘者事件，任務後再詢問是否察覺。</p></article><article class="study-step"><h2>結果與原理</h2><p>分析192人、跨16條件，46%未注意到意外事件。察覺受任務與注意目標影響；生活中只顧找出口而漏看熟人，是可用來理解的情境。</p></article></div><p class="closing">46%是跨條件意外事件漏看率，不是所有大猩猩版本或所有人的固定比例。</p><p class="sources">來源：<a href="#ref-5" data-source="5">[5]</a></p></section><section class="slide" data-layout="misconception" id="p05" hidden><ol class="route" aria-label="課程主線"><li class="current" aria-current="step">選擇</li><li>分配</li><li>處理</li><li>回到生活</li></ol><p class="eyebrow">選擇</p><h1>漏看一次，不代表眼睛壞了</h1><p class="lead">漏看與注意目標有關，不能直接診斷眼睛或能力。</p><p class="content-p">非注意盲視描述特定任務下的察覺現象；白話說，是當時沒有注意到，不等於看不見的東西都來自視力損傷。</p><div class="misconceptions"><article class="text-block"><h2>直覺：這麼明顯，一定看得到</h2><p>較準確：明顯可見，仍可能沒有被察覺。</p></article><article class="text-block"><h2>直覺：看第二次就代表原本也會看到</h2><p>較準確：已知事件或重看可能改變觀察策略，不能當作同樣的首次體驗。</p></article></div><aside class="reader-example"><h2>回到車站</h2><p>一個人只顧找出口而沒注意你揮手，不能單憑這一次漏看，就判定他不認真或能力很差。</p></aside><p class="closing">先問當時在做什麼，再解釋漏看；接下來看多件事一起出現時，注意要怎麼分配。</p><p class="sources">來源：<a href="#ref-2" data-source="2">[2]</a><a href="#ref-5" data-source="5">[5]</a></p></section><section class="slide" data-layout="dual-timeline" id="p06"><ol class="route" aria-label="課程主線"><li class="read">選擇</li><li class="current" aria-current="step">分配</li><li>處理</li><li>回到生活</li></ol><p class="eyebrow">分配注意 / 兩種安排</p><h1>同時做，和來回做，是兩種不同安排</h1><p class="lead">「多工」可能同時進行，也可能來回切換。先分清楚，才知道怎麼比較。</p><p class="termline">多工（multitasking）常統稱兩種安排。分散注意力（divided attention）談兩項以上任務同時進行時的注意配置，不直接等於「分心」或「被打斷」。</p><div class="arrangements"><article class="arrangement same"><div class="arrangement-intro"><h2>同時進行<span class="eng">分散注意力 divided attention／雙重任務 dual task</span></h2><p>兩項工作在同一段時間持續進行。</p></div><div class="arrangement-content"><p class="scenario">教學例子：一邊讀課文、一邊聽同學說話。兩項工作在同一段時間進行，需要觀察每一項工作表現。</p><div class="timeline"><span class="track-label">任務A</span><div class="track"><span class="task full">讀課文</span></div><span class="track-label">任務B</span><div class="track"><span class="task listen full">聽同學說話</span></div></div><p class="axis"><span>時間較早</span><span>時間較晚</span></p><div class="compare"><strong>怎樣比較表現？</strong><br>把「單獨閱讀」和「邊聽邊讀」的閱讀理解相比；聽同學說話也要有單獨聽的基準。不能只看其中一件有沒有完成。</div></div></article><article class="arrangement switch"><div class="arrangement-intro"><h2>來回切換<span class="eng">任務切換 task switching</span></h2><p>當下處理的任務目標依序改變。</p></div><div class="arrangement-content"><p class="scenario">教學例子：先讀課文，改回訊息，再接回閱讀。當下的任務目標依次改變，不是兩項一直同時進行。</p><div class="timeline"><span class="track-label">當下任務</span><div class="track"><span class="task">讀課文</span><span class="task message">回訊息</span><span class="task">接回閱讀</span></div></div><p class="axis"><span>時間較早</span><span>時間較晚</span></p><div class="compare"><strong>怎樣比較表現？</strong><br>研究可比較換任務與重複同一任務時的表現；日常則可比較兩件事都完成後的時間與品質。</div></div></article></div><p class="takeaway">下一頁先看研究者如何觀察切換的代價，再輪到你體驗。時間軸只表示安排，長度不是研究數據。</p><p class="sources">來源：<a href="#ref-1" data-source="1" aria-label="查看來源 1">[1]</a><a href="#ref-4" data-source="4" aria-label="查看來源 4">[4]</a></p></section><section class="slide" data-layout="research-story" id="p07" hidden><ol class="route" aria-label="課程主線"><li class="read">選擇</li><li class="current" aria-current="step">分配</li><li>處理</li><li>回到生活</li></ol><p class="eyebrow">分配</p><h1>換一件事，其實也要付出時間？</h1><p class="lead">換一個任務，可能也需要額外時間。</p><p class="content-p">切換成本（switch cost）是相對持續或重複同一任務，改做另一任務增加的表現代價。白話說，事情做得來，不代表接上另一套目標與規則完全不費時。</p><div class="research-story"><aside class="research-sidebar"><strong>2001</strong><span>依APA研究解說轉述</span></aside><div class="block-stack"><article class="text-block"><h2>研究者在問什麼？</h2><p>依APA解說，Joshua Rubinstein、Jeffrey Evans與David Meyer於2001年發表四個實驗，探討切換的時間代價及任務條件的影響。</p></article><article class="text-block"><h2>讓人做什麼？</h2><p>年輕成人切換不同任務，例如解數學題或分類幾何物件；觀察切換所增加的時間，而不只問主觀忙碌感。</p></article><article class="text-block"><h2>結果怎樣？</h2><p>切換多花時間，任務較複雜或不熟悉時代價較大。相關研究也指出準備可減少但未必消除代價。</p></article></div></div><aside class="reader-example"><h2>生活例子</h2><p>讀課文是在理解段落，回訊息則改為組織回覆；任務目標與處理要求改變了。這是教學情境，不是上述實驗材料。</p></aside><p class="closing">原理依APA二手綜整；不能推出每人做任何多工都固定損失同樣效率。先猜下一頁哪種安排較快。</p><p class="sources">來源：<a href="#ref-4" data-source="4">[4]</a></p></section><section class="slide" data-layout="interactive-switch" id="p08" hidden><ol class="route" aria-label="課程主線"><li class="read">選擇</li><li class="current" aria-current="step">分配</li><li>處理</li><li>回到生活</li></ol><p class="eyebrow">分配注意 / 任務切換體驗</p><h1>換規則時，你會慢下來嗎？</h1><p class="lead">同樣兩種判斷，規則排法不同，作答會有差嗎？</p><div class="intro-grid"><div class="instructions"><h2>看數字之前，先看規則</h2><p>你會看到一個數字及目前規則。奇偶規則問「奇數還是偶數」；大小規則問「比5小還是比5大」。例如7，在奇偶題答奇數，在大小題答大於5。</p><p>先做6題練習，熟悉兩種規則及兩個答案按鈕。桌機可按F或J，手機可直接點答案。</p></div><div class="rounds"><div class="round-card"><strong>分段輪</strong><p>先連做6題奇偶，再連做6題大小。</p></div><div class="round-card"><strong>交替輪</strong><p>每題換規則，奇偶與大小各6題。</p></div><p class="fine">兩輪匹配任務種類、題數、數字範圍及按鍵方式；改變的是規則安排。這是課堂教學改編，不是原始實驗重現。</p></div></div><div class="experiment"><div class="exp-top"><span id="trial-count">練習6題 · 每輪12題</span><span id="rule" class="rule">準備好再開始</span></div><div id="stimulus" class="stimulus" aria-live="polite" aria-atomic="true">—</div><div class="answers"><button id="answer-left" disabled><span id="left-label">左側答案</span><kbd>F</kbd></button><button id="answer-right" disabled><span id="right-label">右側答案</span><kbd>J</kbd></button></div><p id="status" class="status" aria-live="polite">先練習；說明與題間停頓不計入作答時間。完成後到下一頁讀結果。</p><div class="actions"><button id="start" class="primary">開始練習</button><button id="continue" class="primary" hidden>開始這一輪</button><button id="skip">先跳過，看解讀</button><button id="sw-view-result" class="result-link" hidden>查看本輪結果</button></div></div><details><summary>想知道計分細節？</summary><p>兩輪各12題，排除5，匹配各規則的數字範圍與左右答案分布，先後順序隨機。每題最多5秒，時間為每題等待作答時間的加總，不含說明與題間停頓。兩輪均完整完成、無逾時、答對數相同且各至少10題，才解讀差值；這是教學門檻，不是常模。</p><p>即使安排匹配，仍不能排除練習、順序及操作的影響，一次差值不是研究效應的純估計。可跳過或重來；離頁、查看來源或切到背景會中止未完成的活動，資料只暫存於本頁記憶體，不上傳。</p></details><p class="sources">來源：<a href="#ref-4" data-source="4" aria-label="查看來源 4">[4]</a></p></section><section class="slide" data-layout="results-comparison" id="p09" hidden><ol class="route" aria-label="課程主線"><li class="read">選擇</li><li class="current" aria-current="step">分配</li><li>處理</li><li>回到生活</li></ol><p class="eyebrow">分配</p><h1>比較快慢之前，先看兩輪做得如何</h1><p class="lead">先看做完了沒有、答得如何，再比較快慢。</p><p class="content-p">活動結果只描述這一輪。條件足夠時，比較交替與分段的作答時間；交替較慢，表示這次花了更多作答時間，不等於測出了穩定的個人能力。</p><div class="result-layout"><section id="results" class="results" aria-live="polite"><h2>這次作答告訴你什麼？</h2><div id="result-grid" class="result-grid"><p class="stat-empty">尚未完成兩輪，可以回到上一頁體驗，或先讀這頁的解讀原則。</p></div><p id="interpret" class="interpret" hidden></p></section><div class="block-stack"><article class="text-block"><h2>如果沒有完成</h2><p>顯示尚未完成，不填入示範成績；有錯漏影響比較時，先看作答情況，不解讀快慢。</p></article><article class="text-block"><h2>如果交替沒有比較慢</h2><p>如實讀出本輪差異；一次結果還可能受練習、順序或操作影響，不能拿它推翻一般研究，也不替自己貼標籤。</p></article><article class="text-block"><h2>熟練的例外</h2><p>某些特定組合充分練習後可能改善，但不能直接推到其他任務。</p></article></div></div><details><summary>想知道切換體驗的計分細節？</summary><p>兩輪各12題；完整完成、無逾時、正確題數相同且各至少10題才比較。每題等待作答時間加總，不含說明及題間停頓。這是活動門檻，不是研究常模。</p></details><button data-go="8">返回切換體驗</button><aside class="reader-example"><h2>生活例子</h2><p>習慣某種日常組合，不等於讀新教材加回訊息也同樣無代價；要交代任務及單獨做的表現。</p></aside><p class="closing">想知道細節時再展開門檻。從怎麼安排兩項工作，接著轉向：選好目標後，其他資訊會不會仍干擾反應？</p><p class="sources">來源：<a href="#ref-1" data-source="1">[1]</a><a href="#ref-4" data-source="4">[4]</a></p></section><section class="slide" data-layout="origin-demonstration" id="p10" hidden><ol class="route" aria-label="課程主線"><li class="read">選擇</li><li class="read">分配</li><li class="current" aria-current="step">處理</li><li>回到生活</li></ol><p class="eyebrow">處理</p><h1>只想看墨色，為什麼字義也來干擾？</h1><p class="lead">只想看墨色，熟悉字義卻可能順勢被啟動。</p><p class="content-p">自動化加工（automatic processing）指某些熟練處理不必每一步刻意指揮就容易啟動。白話例子：看到熟悉文字時，可能順勢讀出意思；這是教學情境，不表示任何字都必然完整被讀懂。</p><div class="origin-pair"><aside class="color-demonstration"><span class="word">紅</span><p>墨色是藍，字義是紅。<br>若規則要求墨色，應回答「藍」。</p><p class="fine">中文教學改編示意</p></aside><div class="block-stack"><article class="text-block"><h2>問題的起源</h2><p>John Ridley Stroop於1935年承接顏色命名與字詞閱讀的速度問題，研究兩種訊息相互干擾的方向。</p></article><article class="text-block"><h2>原研究怎麼做？</h2><p>一種作業讀字，另一種說出衝突色字的墨色，並與色塊命名比較；使用口語及整張材料計時。</p></article><article class="text-block"><h2>結果與Stroop效應 Stroop effect</h2><p>命名衝突色字墨色比命名色塊耗時更多。無關字義帶來競爭是便於理解的解釋，並非唯一確定機制。</p></article></div></div><aside class="reader-example"><h2>接回前兩段</h2><p>選墨色作目標，不保證字義完全被排除。這裡看的是處理干擾，不是直接測同時做幾件事；下一頁用按鍵體驗。</p></aside><p class="closing">自動化仍受注意條件調節；原始色塊基準與本活動的一致色字基準不同。</p><p class="sources">來源：<a href="#ref-3" data-source="3">[3]</a><a href="#ref-6" data-source="6">[6]</a><a href="#ref-7" data-source="7">[7]</a></p></section><section class="slide" data-layout="interactive-stroop" id="p11" hidden><ol class="route" aria-label="課程主線"><li class="read">選擇</li><li class="read">分配</li><li class="current" aria-current="step">處理</li><li>回到生活</li></ol><p class="eyebrow">處理</p><h1>這次請回答顏色，不要讀字</h1><p class="lead">看見「紅」字，也可能要回答「藍」。</p><p class="content-p">這裡再次將墨色設為目標：以藍色顯示的「紅」，應答藍。字義與墨色相同叫一致，兩者不同叫不一致。</p><div class="game-view"><div class="intro-grid"><article class="text-block"><h2>先練習4題</h2><p>用四個顏色名稱按鈕或數字鍵1–4回答墨色，練習不納入結果。</p></article><article class="text-block"><h2>再做24題正式題</h2><p>一致與不一致各12題，每題最多5秒。可以跳過、重來；結果只留在此頁記憶體，不上傳。</p></article></div><div class="experiment stroop-board"><div class="exp-top"><span id="st-count">4題練習，24題正式題</span><span class="rule">回答墨色</span></div><div class="stimulus" id="st-stimulus" aria-live="polite">—</div><div class="answers"><button data-st-answer="0" disabled>紅<kbd>1</kbd></button><button data-st-answer="1" disabled>藍<kbd>2</kbd></button><button data-st-answer="2" disabled>綠<kbd>3</kbd></button><button data-st-answer="3" disabled>紫<kbd>4</kbd></button></div><p id="st-status" class="status" aria-live="polite">先看操作說明，再開始練習。</p><div class="actions"><button id="st-start" class="primary">開始練習</button><button id="st-skip">跳過，看解讀</button><button id="st-view-result" hidden>查看本輪結果</button></div></div><details><summary>想知道題目與計分細節？</summary><p>一致與不一致各12題、各墨色平衡，每題最多5秒。僅正確且未逾時的正式題納入條件平均；任一條件不足6題不解讀差值。練習不納入。可跳過／重來；離開或切至背景會中止未完成活動，資料不上傳。</p></details></div><aside class="reader-example"><h2>怎麼連到生活？</h2><p>和熟悉文字容易順勢被讀出意思的情境一樣，本活動讓你留意無關字義是否干擾指定目標；不直接推估日常多工效率。</p></aside><p class="closing">完成後到下一頁讀自己的數字；更多計分細節放在摺疊區。</p><p class="sources">來源：<a href="#ref-6" data-source="6">[6]</a><a href="#ref-7" data-source="7">[7]</a></p></section><section class="slide" data-layout="reading-results" id="p12" hidden><ol class="route" aria-label="課程主線"><li class="read">選擇</li><li class="read">分配</li><li class="current" aria-current="step">處理</li><li>回到生活</li></ol><p class="eyebrow">處理</p><h1>一個差值，能告訴你什麼？</h1><p class="lead">數字描述一次作答，不是對你貼上的標籤。</p><p class="content-p">Stroop按鍵版的差值是不一致條件平均反應時間減一致條件平均反應時間。正值代表這次不一致平均較慢，零或負值只描述本次方向。</p><div class="reading-results"><section id="st-results" class="results" aria-live="polite"><h2>你這一輪的結果</h2><div id="st-result-grid" class="result-grid"><p class="stat-empty">尚未完成Stroop體驗；仍可先讀如何理解差值。</p></div><p id="st-interpret" class="interpret" hidden></p></section><div class="block-stack"><article class="text-block"><h2>先問資料足夠嗎？</h2><p>只計正確且未逾時的正式題；錯誤與逾時另外列。資料不足就顯示不足，不解讀差值。</p></article><article class="text-block"><h2>再問能說明什麼？</h2><p>這是當次條件比較，不是注意力疾病診斷、正常分數或日常多工能力。沒做活動仍可閱讀解讀原則，不顯示假結果。</p></article><article class="text-block"><h2>兩個遊戲共同保留的限制</h2><p>題數短、順序與操作可能影響結果。不要把一次體驗當研究重現，也不要把不同比較基準的數值直接混用。</p></article></div></div><button data-go="11">返回Stroop體驗</button><aside class="reader-example"><h2>生活例子</h2><p>這輪差值大，不代表明天讀書一定較差；個人生活表現並未在這個活動被直接測量。</p></aside><p class="closing">Stroop的處理干擾、切換的規則調整與資訊選擇，都要放回當時的任務條件理解。</p><p class="sources">來源：<a href="#ref-6" data-source="6">[6]</a><a href="#ref-7" data-source="7">[7]</a></p></section><section class="slide" data-layout="integration-map" id="p13" hidden><ol class="route" aria-label="課程主線"><li class="read">選擇</li><li class="read">分配</li><li class="read">處理</li><li class="current" aria-current="step">回到生活</li></ol><p class="eyebrow">回到生活</p><h1>選擇、分配、處理，其實問的是同一段生活</h1><p class="lead">三個視角，解釋同一段生活。</p><p class="content-p">選擇問「優先處理什麼」，分配問「多項任務怎麼安排」，處理問「哪些訊息影響反應」。這是教學地圖，不是大腦的固定串行流水線。</p><div class="chapter-map integration"><article class="chapter-node"><h2>選擇</h2><p>讀課文時，把哪一段當成當前目標？</p></article><article class="chapter-node"><h2>分配</h2><p>訊息來了，是繼續讀、同時應付，還是停下來回覆？</p></article><article class="chapter-node"><h2>處理</h2><p>即使決定只看墨色，熟悉字義仍可能干擾反應；選好目標不保證完全排除無關資訊。</p></article></div><aside class="reader-example"><h2>把例子接起來</h2><p>以讀課文、收到訊息與熟悉文字為教學情境，可分別提出三個問題；不表示三種現象必須同時發生。</p></aside><p class="closing">Stroop放在處理段，是為了補上「選定之後，如何反應」的問題。</p><p class="sources">來源：<a href="#ref-1" data-source="1">[1]</a><a href="#ref-4" data-source="4">[4]</a><a href="#ref-6" data-source="6">[6]</a></p></section><section class="slide" data-layout="application-cases" id="p14" hidden><ol class="route" aria-label="課程主線"><li class="read">選擇</li><li class="read">分配</li><li class="read">處理</li><li class="current" aria-current="step">回到生活</li></ol><p class="eyebrow">回到生活</p><h1>把注意力原理變成讀書與駕駛的選擇</h1><p class="lead">把原理變成選擇，而不是追求消滅所有多工。</p><p class="content-p">先認清目標、競爭資訊及任務安排，再提出可嘗試的做法。生活建議要保留條件，不保證固定改善幅度。</p><div class="applications"><article class="application-case"><h2>讀書時</h2><p>可嘗試集中處理非緊急訊息，減少不必要來回切換，再觀察是否較容易接續閱讀。</p></article><article class="application-case"><h2>駕駛時</h2><p>認知分心不只手眼被占用；Noba轉述Strayer與Johnston（2001）的研究，手持與免持通話都可能干擾表現。免持不保證注意力完全保留。</p></article><article class="application-case"><h2>回顧三問及示範</h2><p>我優先處理什麼？例如眼前課文。是同時做還是切換？例如停下來回訊息屬切換。用什麼比較？例如兩件事都完成的總時間與品質。</p></article></div><aside class="reader-example"><h2>輪到你的情境</h2><p>想一個生活例子，試著用三問說清楚；這是理解練習，不是能力量表。</p></aside><p class="closing">駕駛研究依教材轉述，不推估個人事故率。</p><p class="sources">來源：<a href="#ref-1" data-source="1">[1]</a><a href="#ref-4" data-source="4">[4]</a></p></section><section class="slide" data-layout="references" id="sources" hidden><ol class="route" aria-label="課程主線"><li class="read">選擇</li><li class="read">分配</li><li class="read">處理</li><li class="read">回到生活</li></ol><p class="eyebrow">資料與查證</p><h1>資料來源：每個說法都能回頭查</h1><p class="lead">每個說法，都能回頭查。</p><p class="content-p">本簡報知識僅來自已確認的Wiki；完整來源與原始論文／教材轉述的區別保留在來源頁。</p><button id="return-source" class="source-return" disabled>返回引用處</button><ol class="source-list"><li id="ref-1" tabindex="-1"><h2>來源 [1]</h2><p>Frances Friedrich（2026，依網站建議書目）。<a href="https://nobaproject.com/modules/attention" target="_blank" rel="noopener noreferrer">Attention</a>. In R. Biswas-Diener &amp; E. Diener (Eds.), Noba textbook series: Psychology. DEF publishers. 開放教材；The Cocktail Party、Dichotic Listening Studies、Divided Attention and Multitasking、Distracted Driving及References。本次重讀；依教材轉述的研究不算另讀原始論文。</p></li><li id="ref-2" tabindex="-1"><h2>來源 [2]</h2><p>潘震澤（2011-05-27）。<a href="https://pansci.asia/archives/4319" target="_blank" rel="noopener noreferrer">為什麼不要邊開車邊講電話？―人類錯覺大全</a>。泛科學。 科普書評／介紹；注意力錯覺與預期段落；本次沿用先前筆記，不擴張使用範圍。</p></li><li id="ref-3" tabindex="-1"><h2>來源 [3]</h2><p>吴彦文、游旭群（2017）。<a href="https://journal.psych.ac.cn/xlxb/CN/10.3724/SP.J.1041.2017.001267" target="_blank" rel="noopener noreferrer">颜色字词的识别真的无需注意力资源的参与？——来自Stroop范式的证据</a>。《心理学报》，49(10)，1267–1276。DOI:10.3724/SP.J.1041.2017.001267。 原始研究；本次重讀書目與摘要，全文閱讀依前次紀錄；理論背景與結論定位為引言及§5–6。不可把本文的啟動典範等同短遊戲。</p></li><li id="ref-4" tabindex="-1"><h2>來源 [4]</h2><p>American Psychological Association（n.d.）。<a href="https://www.apa.org/topics/research/multitasking" target="_blank" rel="noopener noreferrer">Multitasking: Switching costs</a>。 專業機構解說；本次重讀What the research shows、What the research means與References。Rogers與Monsell等的年份與敘述來自此二手來源，不聲稱另讀原始論文。</p></li><li id="ref-5" tabindex="-1"><h2>來源 [5]</h2><p>Simons, D. J., &amp; Chabris, C. F.（1999）。<a href="https://www.chabris.com/Simons1999.pdf" target="_blank" rel="noopener noreferrer">Gorillas in our midst: Sustained inattentional blindness for dynamic events</a>. Perception, 28(9), 1059–1074. DOI:10.1068/p281059。 原始研究，作者網站PDF；本次重讀引言、方法、結果／Table 1。</p></li><li id="ref-6" tabindex="-1"><h2>來源 [6]</h2><p>Stroop, J. R.（1935）。<a href="https://psychclassics.yorku.ca/Stroop/" target="_blank" rel="noopener noreferrer">Studies of interference in serial verbal reactions</a>. Journal of Experimental Psychology, 18, 643–662. DOI:10.1037/h0054651。 York University 經典文獻HTML轉錄；本次重讀引言與實驗2，原文定位pp.646–651。</p></li><li id="ref-7" tabindex="-1"><h2>來源 [7]</h2><p>PsyToolkit（2026-07-16更新，依前次頁尾紀錄）。<a href="https://www.psytoolkit.org/experiment-library/stroop.html" target="_blank" rel="noopener noreferrer">Stroop task</a>。 官方任務文件；本次重讀Introduction、About this implementation、Data output file，提供Stroop完整姓名與按鍵版比較方法。未執行其示範或複製其程式。</p></li></ol><p class="closing">原文連結需連網；簡報與遊戲離線可用。Noba改寫署名Frances Friedrich／Noba，採CC BY-NC-SA 4.0；其他來源各自保留權利。</p><p class="sources">來源：<a href="#ref-1" data-source="1">[1]</a><a href="#ref-2" data-source="2">[2]</a><a href="#ref-3" data-source="3">[3]</a><a href="#ref-4" data-source="4">[4]</a><a href="#ref-5" data-source="5">[5]</a><a href="#ref-6" data-source="6">[6]</a><a href="#ref-7" data-source="7">[7]</a></p></section></main><footer><span id="page-label" class="page-label main-label"></span><span class="keyboard-hint">左右鍵切換 · 長內容可上下捲動</span><div class="nav"><button id="prev">上一頁</button><button id="next">下一頁</button></div></footer><noscript>請允許本機檔案執行JavaScript，才能使用逐頁導覽與活動。</noscript><script>'use strict';
+</style></head><body><header><div class="brand">注意力的極限<span class="sample-tag">選擇 · 分配 · 處理</span></div><label><select id="jump" aria-label="跳到投影片"><option value="0">封面</option><option value="1">1 · 你真的看到眼前的一切嗎？</option><option value="2">2 · 注意力，是把有限處理能力用在哪裡？</option><option value="3">3 · 吵雜餐廳裡，你為何仍能跟著同學說話？</option><option value="4">4 · 數對傳球，為什麼仍可能漏看意外人物？</option><option value="5">5 · 漏看一次，不代表眼睛壞了</option><option value="6">6 · 同時做，和來回做，是兩種不同安排</option><option value="7">7 · 換一件事，其實也要付出時間？</option><option value="8">8 · 換規則時，你會慢下來嗎？</option><option value="9">9 · 比較快慢之前，先看兩輪做得如何</option><option value="10">10 · 只想看墨色，為什麼字義也來干擾？</option><option value="11">11 · 這次請回答顏色，不要讀字</option><option value="12">12 · 一個差值，能告訴你什麼？</option><option value="13">13 · 選擇、分配、處理，其實問的是同一段生活</option><option value="14">14 · 把注意力原理變成讀書與駕駛的選擇</option><option value="15">來源</option></select></label></header><main><section class="slide" data-layout="cover" id="cover" hidden><ol class="route" aria-label="課程主線"><li>選擇</li><li>分配</li><li>處理</li><li>回到生活</li></ol><p class="eyebrow">注意力的極限</p><h1>封面：你以為自己注意到了多少？</h1><p class="lead">從「我一定看得到」開始，重新認識注意力。</p><p class="content-p">這份課程用選擇、分配、處理三個問題，帶你理解注意力的極限，最後回到讀書與駕駛。你可以先預測，再看研究與做兩個短體驗。</p><div class="hero"><p class="spotlight">選擇要看什麼；分配怎麼做事；處理哪些訊息會干擾。</p><div class="chapter-map"><div class="chapter-node"><h2>選擇</h2><p>資訊太多，先優先理解其中一部分。</p></div><div class="chapter-node"><h2>分配</h2><p>多項任務是同時做，還是來回切換？</p></div><div class="chapter-node"><h2>處理</h2><p>選好目標後，無關資訊仍可能干擾反應。</p></div></div><button class="primary" data-go="1">開始閱讀</button></div></section><section class="slide" data-layout="prediction" id="p01" hidden><ol class="route" aria-label="課程主線"><li class="current" aria-current="step">選擇</li><li>分配</li><li>處理</li><li>回到生活</li></ol><p class="eyebrow">選擇</p><h1>你真的看到眼前的一切嗎？</h1><p class="lead">你很確定，自己不會漏掉明顯的事嗎？</p><p class="content-p">想像你在車站找出口，熟人在旁邊揮手。你覺得自己一定會注意到他嗎？先選一個直覺答案，再展開說明。</p><div class="prediction"><article class="text-block"><h2>先猜</h2><p>我覺得會／不一定。這裡只記錄你的預測，不給能力分數。</p></article><div class="choice-buttons"><button data-reveal="prediction-reveal">我覺得會</button><button data-reveal="prediction-reveal">不一定</button></div><div id="prediction-reveal" class="reveal" hidden><article class="text-block"><h2>揭曉</h2><p>專心找出口時，仍可能沒有察覺熟人。眼前可見的事物，不保證已被你注意到；後面的傳球研究會把這個問題放進可檢查的任務。</p></article></div></div><p class="closing">車站情境是教學例子，不是本課已對你做過的實驗。</p><p class="sources">來源：<a href="#ref-5" data-source="5">[5]</a></p></section><section class="slide" data-layout="concept-map" id="p02" hidden><ol class="route" aria-label="課程主線"><li class="current" aria-current="step">選擇</li><li>分配</li><li>處理</li><li>回到生活</li></ol><p class="eyebrow">選擇</p><h1>注意力，是把有限處理能力用在哪裡？</h1><p class="lead">資訊很多時，先決定要把處理能力用在哪裡。</p><p class="content-p">注意力（attention）涉及在有限處理能力下選擇資訊。這裡把全課整理成三個提問，幫你理解同一個生活情境。</p><div class="chapter-map "><article class="chapter-node"><h2>選擇：先看哪些？</h2><p>讀課文時，哪一段資訊是現在要理解的目標？</p></article><article class="chapter-node"><h2>分配：多件事怎麼安排？</h2><p>要同時聽別人說話，還是停下閱讀再回訊息？</p></article><article class="chapter-node"><h2>處理：什麼會干擾反應？</h2><p>即使只想看墨色，熟悉字義也可能影響答案。</p></article></div><aside class="reader-example"><h2>教學類比</h2><p>像書桌放了許多資料，你先挑一份細讀；其他資料仍在，不等於都已理解。</p></aside><p class="closing">三段是理解問題的視角，不表示大腦必須依此順序運作。</p><p class="sources">來源：<a href="#ref-1" data-source="1">[1]</a></p></section><section class="slide" data-layout="listening-case" id="p03" hidden><ol class="route" aria-label="課程主線"><li class="current" aria-current="step">選擇</li><li>分配</li><li>處理</li><li>回到生活</li></ol><p class="eyebrow">選擇</p><h1>吵雜餐廳裡，你為何仍能跟著同學說話？</h1><p class="lead">注意力能跟著一段對話，不代表其他聲音消失了。</p><p class="content-p">選擇性注意力（selective attention）是在多種資訊中優先處理一部分、忽略干擾的能力。白話說，就是決定現在要仔細理解誰。</p><div class="listening"><article class="text-block"><h2>餐廳裡的例子</h2><p>你跟著面前同學說話，隔壁桌的聲音仍在，卻不一定能逐句重述。</p></article><div class="block-stack"><article class="text-block"><h2>人們怎麼研究？</h2><p>Noba教材介紹Cherry（1953）、Moray（1959）等雙耳分聽（dichotic listening）研究：兩耳聽不同訊息，跟讀其中一耳，再檢查可報告的內容。</p></article><article class="text-block"><h2>這發現了什麼？</h2><p>人通常能說出跟讀內容；對未注意的一耳，往往較能報告聲音特徵，而非完整意思。</p></article></div></div><aside class="reader-example"><h2>雞尾酒會效應 cocktail party effect</h2><p>複雜聲音中能跟隨特定對話，某些有意義線索仍可能吸引注意；不是每次都一定聽見自己的名字。</p></aside><p class="closing">研究依Noba教材轉述；不能由此斷言未注意訊息完全沒有加工。</p><p class="sources">來源：<a href="#ref-1" data-source="1">[1]</a></p></section><section class="slide" data-layout="study-sequence" id="p04" hidden><ol class="route" aria-label="課程主線"><li class="current" aria-current="step">選擇</li><li>分配</li><li>處理</li><li>回到生活</li></ol><p class="eyebrow">選擇</p><h1>數對傳球，為什麼仍可能漏看意外人物？</h1><p class="lead">數著傳球，仍可能錯過畫面裡的意外人物。</p><p class="content-p">非注意盲視（inattentional blindness）是注意投入別處時，沒有察覺眼前可見物件的現象。白話說，看到畫面不代表察覺畫面裡每件事。</p><div class="key-stat"><strong>46%</strong><span>192人、跨16個條件，未察覺意外事件的比例；不是所有版本的固定比例。</span></div><div class="study-grid"><article class="study-step"><h2>問題從哪裡來？</h2><p>Daniel J. Simons與Christopher F. Chabris在1999年承接選擇性觀看研究，問任務難度與意外物件特徵如何影響察覺。</p></article><article class="study-step"><h2>怎麼做？</h2><p>觀察者追蹤黑白隊伍中的指定一隊並計數傳球；有不同計數難度、影片形式及大猩猩／撐傘者事件，任務後再詢問是否察覺。</p></article><article class="study-step"><h2>結果與原理</h2><p>分析192人、跨16條件，46%未注意到意外事件。察覺受任務與注意目標影響；生活中只顧找出口而漏看熟人，是可用來理解的情境。</p></article></div><p class="closing">46%是跨條件意外事件漏看率，不是所有大猩猩版本或所有人的固定比例。</p><p class="sources">來源：<a href="#ref-5" data-source="5">[5]</a></p></section><section class="slide" data-layout="misconception" id="p05" hidden><ol class="route" aria-label="課程主線"><li class="current" aria-current="step">選擇</li><li>分配</li><li>處理</li><li>回到生活</li></ol><p class="eyebrow">選擇</p><h1>漏看一次，不代表眼睛壞了</h1><p class="lead">漏看與注意目標有關，不能直接診斷眼睛或能力。</p><p class="content-p">非注意盲視描述特定任務下的察覺現象；白話說，是當時沒有注意到，不等於看不見的東西都來自視力損傷。</p><div class="misconceptions"><article class="text-block"><h2>直覺：這麼明顯，一定看得到</h2><p>較準確：明顯可見，仍可能沒有被察覺。</p></article><article class="text-block"><h2>直覺：看第二次就代表原本也會看到</h2><p>較準確：已知事件或重看可能改變觀察策略，不能當作同樣的首次體驗。</p></article></div><aside class="reader-example"><h2>回到車站</h2><p>一個人只顧找出口而沒注意你揮手，不能單憑這一次漏看，就判定他不認真或能力很差。</p></aside><p class="closing">先問當時在做什麼，再解釋漏看；接下來看多件事一起出現時，注意要怎麼分配。</p><p class="sources">來源：<a href="#ref-2" data-source="2">[2]</a><a href="#ref-5" data-source="5">[5]</a></p></section><section class="slide" data-layout="dual-timeline" id="p06"><ol class="route" aria-label="課程主線"><li class="read">選擇</li><li class="current" aria-current="step">分配</li><li>處理</li><li>回到生活</li></ol><p class="eyebrow">分配注意 / 兩種安排</p><h1>同時做，和來回做，是兩種不同安排</h1><p class="lead">「多工」可能同時進行，也可能來回切換。先分清楚，才知道怎麼比較。</p><p class="termline">多工（multitasking）常統稱兩種安排。分散注意力（divided attention）談兩項以上任務同時進行時的注意配置，不直接等於「分心」或「被打斷」。</p><div class="arrangements"><article class="arrangement same"><div class="arrangement-intro"><h2>同時進行<span class="eng">分散注意力 divided attention／雙重任務 dual task</span></h2><p>兩項工作在同一段時間持續進行。</p></div><div class="arrangement-content"><p class="scenario">教學例子：一邊讀課文、一邊聽同學說話。兩項工作在同一段時間進行，需要觀察每一項工作表現。</p><div class="timeline"><span class="track-label">任務A</span><div class="track"><span class="task full">讀課文</span></div><span class="track-label">任務B</span><div class="track"><span class="task listen full">聽同學說話</span></div></div><p class="axis"><span>時間較早</span><span>時間較晚</span></p><div class="compare"><strong>怎樣比較表現？</strong><br>把「單獨閱讀」和「邊聽邊讀」的閱讀理解相比；聽同學說話也要有單獨聽的基準。不能只看其中一件有沒有完成。</div></div></article><article class="arrangement switch"><div class="arrangement-intro"><h2>來回切換<span class="eng">任務切換 task switching</span></h2><p>當下處理的任務目標依序改變。</p></div><div class="arrangement-content"><p class="scenario">教學例子：先讀課文，改回訊息，再接回閱讀。當下的任務目標依次改變，不是兩項一直同時進行。</p><div class="timeline"><span class="track-label">當下任務</span><div class="track"><span class="task">讀課文</span><span class="task message">回訊息</span><span class="task">接回閱讀</span></div></div><p class="axis"><span>時間較早</span><span>時間較晚</span></p><div class="compare"><strong>怎樣比較表現？</strong><br>研究可比較換任務與重複同一任務時的表現；日常則可比較兩件事都完成後的時間與品質。</div></div></article></div><p class="takeaway">下一頁先看研究者如何觀察切換的代價，再輪到你體驗。時間軸只表示安排，長度不是研究數據。</p><p class="sources">來源：<a href="#ref-1" data-source="1" aria-label="查看來源 1">[1]</a><a href="#ref-4" data-source="4" aria-label="查看來源 4">[4]</a></p></section><section class="slide" data-layout="research-story" id="p07" hidden><ol class="route" aria-label="課程主線"><li class="read">選擇</li><li class="current" aria-current="step">分配</li><li>處理</li><li>回到生活</li></ol><p class="eyebrow">分配</p><h1>換一件事，其實也要付出時間？</h1><p class="lead">換一個任務，可能也需要額外時間。</p><p class="content-p">切換成本（switch cost）是相對持續或重複同一任務，改做另一任務增加的表現代價。白話說，事情做得來，不代表接上另一套目標與規則完全不費時。</p><div class="research-story"><aside class="research-sidebar"><strong>2001</strong><span>依APA研究解說轉述</span></aside><div class="block-stack"><article class="text-block"><h2>研究者在問什麼？</h2><p>依APA解說，Joshua Rubinstein、Jeffrey Evans與David Meyer於2001年發表四個實驗，探討切換的時間代價及任務條件的影響。</p></article><article class="text-block"><h2>讓人做什麼？</h2><p>年輕成人切換不同任務，例如解數學題或分類幾何物件；觀察切換所增加的時間，而不只問主觀忙碌感。</p></article><article class="text-block"><h2>結果怎樣？</h2><p>切換多花時間，任務較複雜或不熟悉時代價較大。相關研究也指出準備可減少但未必消除代價。</p></article></div></div><aside class="reader-example"><h2>生活例子</h2><p>讀課文是在理解段落，回訊息則改為組織回覆；任務目標與處理要求改變了。這是教學情境，不是上述實驗材料。</p></aside><p class="closing">原理依APA二手綜整；不能推出每人做任何多工都固定損失同樣效率。先猜下一頁哪種安排較快。</p><p class="sources">來源：<a href="#ref-4" data-source="4">[4]</a></p></section><section class="slide" data-layout="interactive-switch" id="p08" hidden><ol class="route" aria-label="課程主線"><li class="read">選擇</li><li class="current" aria-current="step">分配</li><li>處理</li><li>回到生活</li></ol><p class="eyebrow">分配注意 / 任務切換體驗</p><h1>換規則時，你會慢下來嗎？</h1><p class="lead">同樣兩種判斷，規則排法不同，作答會有差嗎？</p><div class="intro-grid"><div class="instructions"><h2>看數字之前，先看規則</h2><p>你會看到一個數字及目前規則。奇偶規則問「奇數還是偶數」；大小規則問「比5小還是比5大」。例如7，在奇偶題答奇數，在大小題答大於5。</p><p>先做6題練習，熟悉兩種規則及兩個答案按鈕。桌機可按F或J，手機可直接點答案。</p></div><div class="rounds"><div class="round-card"><strong>分段輪</strong><p>先連做6題奇偶，再連做6題大小。</p></div><div class="round-card"><strong>交替輪</strong><p>每題換規則，奇偶與大小各6題。</p></div><p class="fine">兩輪匹配任務種類、題數、數字範圍及按鍵方式；改變的是規則安排。這是課堂教學改編，不是原始實驗重現。</p></div></div><div class="experiment"><div class="exp-top"><span id="trial-count">練習6題 · 每輪12題</span><span id="rule" class="rule">準備好再開始</span></div><div id="stimulus" class="stimulus" aria-live="polite" aria-atomic="true">—</div><div class="answers"><button id="answer-left" disabled><span id="left-label">左側答案</span><kbd>F</kbd></button><button id="answer-right" disabled><span id="right-label">右側答案</span><kbd>J</kbd></button></div><p id="status" class="status" aria-live="polite">先練習；說明與題間停頓不計入作答時間。完成後到下一頁讀結果。</p><div class="actions"><button id="start" class="primary">開始練習</button><button id="continue" class="primary" hidden>開始這一輪</button><button id="skip">先跳過，看解讀</button><button id="sw-view-result" class="result-link" hidden>查看本輪結果</button></div></div><details><summary>想知道計分細節？</summary><p>兩輪各12題，排除5，匹配各規則的數字範圍與左右答案分布，先後順序隨機。每題最多5秒，時間為每題等待作答時間的加總，不含說明與題間停頓。兩輪均完整完成、無逾時、答對數相同且各至少10題，才解讀差值；這是教學門檻，不是常模。</p><p>即使安排匹配，仍不能排除練習、順序及操作的影響，一次差值不是研究效應的純估計。可跳過或重來；離頁、查看來源或切到背景會中止未完成的活動，資料只暫存於本頁記憶體，不上傳。</p></details><p class="sources">來源：<a href="#ref-4" data-source="4" aria-label="查看來源 4">[4]</a></p></section><section class="slide" data-layout="results-comparison" id="p09" hidden><ol class="route" aria-label="課程主線"><li class="read">選擇</li><li class="current" aria-current="step">分配</li><li>處理</li><li>回到生活</li></ol><p class="eyebrow">分配</p><h1>比較快慢之前，先看兩輪做得如何</h1><p class="lead">研究預期切換要多花時間；你的結果要放回比較條件理解。</p><p class="content-p">切換成本是相對重複同一任務，換任務增加的時間代價。研究中切換題比重複題慢；白話說，改接另一套目標與規則，也可能需要時間。本活動因此預期：頻繁換規則的交替輪，可能比分段輪耗時。</p><div class="result-layout"><section id="results" class="results" aria-live="polite"><h2>這次作答告訴你什麼？</h2><div id="result-grid" class="result-grid"><p class="stat-empty">尚未完成兩輪，可以回到上一頁體驗，或先讀這頁的解讀原則。</p></div><p id="interpret" class="interpret" hidden></p></section><div class="block-stack"><article class="text-block"><h2>原研究怎麼發現？</h2><p>依APA轉述，Rubinstein等人的研究發現切換多花時間，較複雜或不熟悉的任務代價較大。Rogers與Monsell的研究也發現切換題比重複題慢，增加準備時間可減少但未消除代價。</p></article><article class="text-block"><h2>本活動比較什麼？</h2><p>分段輪只在中間換一次規則，交替輪則逐題換。若交替較慢，方向與切換需調整目標與規則的解釋一致；但兩輪總時間差不是研究中單一切換題的純成本，也沒有測「同時做」的表現。</p></article><article class="text-block"><h2>如果沒有出現預期方向？</h2><p>交替持平或較快，代表這次沒有呈現預期方向。練習、兩輪先後、規則熟悉度與按鍵操作都可能影響結果；這些是待檢查的可能因素，不能只憑差值認定是哪一個原因。</p></article><article class="text-block"><h2>先看作答品質，再談快慢</h2><p>未完成、有逾時或正確情況不適合比較時，不判斷結果是否符合預期。特定任務充分練習可能改善，也不能推到所有工作組合。</p></article></div></div><details><summary>想知道切換體驗的計分細節？</summary><p>兩輪各12題；完整完成、無逾時、正確題數相同且各至少10題才比較。每題等待作答時間加總，不含說明及題間停頓。這是活動門檻，不是研究常模。</p></details><button data-go="8">返回切換體驗</button><aside class="reader-example"><h2>把原理帶回生活</h2><p>讀課文後回訊息，再回課文找脈絡，像在接回不同目標。這是教學類比；即使這次交替輪較快，也不能由此推論邊讀新教材邊回訊息一定更有效率。</p></aside><p class="closing">先分清原研究的切換／重複比較與本活動的兩輪總時間，再看當次方向。接下來問：選好目標後，其他資訊為何仍會干擾？</p><p class="sources">來源：<a href="#ref-1" data-source="1">[1]</a><a href="#ref-4" data-source="4">[4]</a></p></section><section class="slide" data-layout="origin-demonstration" id="p10" hidden><ol class="route" aria-label="課程主線"><li class="read">選擇</li><li class="read">分配</li><li class="current" aria-current="step">處理</li><li>回到生活</li></ol><p class="eyebrow">處理</p><h1>只想看墨色，為什麼字義也來干擾？</h1><p class="lead">只想看墨色，熟悉字義卻可能順勢被啟動。</p><p class="content-p">自動化加工（automatic processing）指某些熟練處理不必每一步刻意指揮就容易啟動。白話例子：看到熟悉文字時，可能順勢讀出意思；這是教學情境，不表示任何字都必然完整被讀懂。</p><div class="origin-pair"><aside class="color-demonstration"><span class="word">紅</span><p>墨色是藍，字義是紅。<br>若規則要求墨色，應回答「藍」。</p><p class="fine">中文教學改編示意</p></aside><div class="block-stack"><article class="text-block"><h2>問題的起源</h2><p>John Ridley Stroop於1935年承接顏色命名與字詞閱讀的速度問題，研究兩種訊息相互干擾的方向。</p></article><article class="text-block"><h2>原研究怎麼做？</h2><p>一種作業讀字，另一種說出衝突色字的墨色，並與色塊命名比較；使用口語及整張材料計時。</p></article><article class="text-block"><h2>結果與Stroop效應 Stroop effect</h2><p>命名衝突色字墨色比命名色塊耗時更多。無關字義帶來競爭是便於理解的解釋，並非唯一確定機制。</p></article></div></div><aside class="reader-example"><h2>接回前兩段</h2><p>選墨色作目標，不保證字義完全被排除。這裡看的是處理干擾，不是直接測同時做幾件事；下一頁用按鍵體驗。</p></aside><p class="closing">自動化仍受注意條件調節；原始色塊基準與本活動的一致色字基準不同。</p><p class="sources">來源：<a href="#ref-3" data-source="3">[3]</a><a href="#ref-6" data-source="6">[6]</a><a href="#ref-7" data-source="7">[7]</a></p></section><section class="slide" data-layout="interactive-stroop" id="p11" hidden><ol class="route" aria-label="課程主線"><li class="read">選擇</li><li class="read">分配</li><li class="current" aria-current="step">處理</li><li>回到生活</li></ol><p class="eyebrow">處理</p><h1>這次請回答顏色，不要讀字</h1><p class="lead">看見「紅」字，也可能要回答「藍」。</p><p class="content-p">這裡再次將墨色設為目標：以藍色顯示的「紅」，應答藍。字義與墨色相同叫一致，兩者不同叫不一致。</p><div class="game-view"><div class="intro-grid"><article class="text-block"><h2>先練習4題</h2><p>用四個顏色名稱按鈕或數字鍵1–4回答墨色，練習不納入結果。</p></article><article class="text-block"><h2>再做24題正式題</h2><p>一致與不一致各12題，每題最多5秒。可以跳過、重來；結果只留在此頁記憶體，不上傳。</p></article></div><div class="experiment stroop-board"><div class="exp-top"><span id="st-count">4題練習，24題正式題</span><span class="rule">回答墨色</span></div><div class="stimulus" id="st-stimulus" aria-live="polite">—</div><div class="answers"><button data-st-answer="0" disabled>紅<kbd>1</kbd></button><button data-st-answer="1" disabled>藍<kbd>2</kbd></button><button data-st-answer="2" disabled>綠<kbd>3</kbd></button><button data-st-answer="3" disabled>紫<kbd>4</kbd></button></div><p id="st-status" class="status" aria-live="polite">先看操作說明，再開始練習。</p><div class="actions"><button id="st-start" class="primary">開始練習</button><button id="st-skip">跳過，看解讀</button><button id="st-view-result" hidden>查看本輪結果</button></div></div><details><summary>想知道題目與計分細節？</summary><p>一致與不一致各12題、各墨色平衡，每題最多5秒。僅正確且未逾時的正式題納入條件平均；任一條件不足6題不解讀差值。練習不納入。可跳過／重來；離開或切至背景會中止未完成活動，資料不上傳。</p></details></div><aside class="reader-example"><h2>怎麼連到生活？</h2><p>和熟悉文字容易順勢被讀出意思的情境一樣，本活動讓你留意無關字義是否干擾指定目標；不直接推估日常多工效率。</p></aside><p class="closing">完成後到下一頁讀自己的數字；更多計分細節放在摺疊區。</p><p class="sources">來源：<a href="#ref-6" data-source="6">[6]</a><a href="#ref-7" data-source="7">[7]</a></p></section><section class="slide" data-layout="reading-results" id="p12" hidden><ol class="route" aria-label="課程主線"><li class="read">選擇</li><li class="read">分配</li><li class="current" aria-current="step">處理</li><li>回到生活</li></ol><p class="eyebrow">處理</p><h1>一個差值，能告訴你什麼？</h1><p class="lead">預期不一致較慢：字義與墨色衝突，可能干擾回答。</p><p class="content-p">Stroop效應的白話重點是：即使想回答墨色，熟悉字義仍可能帶來競爭。依這個解釋，本活動預期不一致條件比一致條件耗時；這是對按鍵活動的原理推論，不是把原始研究的色塊基準改寫成一致色字。</p><div class="reading-results"><section id="st-results" class="results" aria-live="polite"><h2>你這一輪的結果</h2><div id="st-result-grid" class="result-grid"><p class="stat-empty">尚未完成Stroop體驗；仍可先讀如何理解差值。</p></div><p id="st-interpret" class="interpret" hidden></p></section><div class="block-stack"><article class="text-block"><h2>原研究發現與本活動不同在哪？</h2><p>Stroop原始研究發現，說出衝突色字的墨色比說出色塊顏色耗時更多。本活動改成逐題按鍵，比較不一致與一致色字；比較基準、材料與反應方式都不同，差值不能直接混用。</p></article><article class="text-block"><h2>你的結果怎麼接回原理？</h2><p>差值＝不一致平均反應時間－一致平均反應時間。正值表示這次不一致較慢，方向與字義干擾的預期一致；零或負值表示這次未呈現預期方向。任何方向都不能單憑一次作答證明或推翻理論。</p></article><article class="text-block"><h2>沒有同方向時，先檢查什麼？</h2><p>練習、題目先後與按鍵操作可能影響結果；題數少時，個別作答也較容易影響平均。先看兩條件的錯誤與逾時，再看納入平均的正確題。這些是可能因素，活動不能判定你的結果由哪個因素造成。</p></article><article class="text-block"><h2>兩個遊戲要一起記住的事</h2><p>未完成或資料不足就不解讀。這裡沒有統計顯著性檢定，也沒有正常分數或診斷；單次方向相符不代表測得穩定能力，方向不同也不表示你不受干擾或日常多工更好。</p></article></div></div><button data-go="11">返回Stroop體驗</button><aside class="reader-example"><h2>生活例子</h2><p>看到熟悉文字時可能順勢讀出意思，是理解字義干擾的教學例子。這輪不一致沒有較慢，仍不能推出讀書時可完全排除所有無關訊息。</p></aside><p class="closing">先看研究比較什麼，再看本次結果的方向與作答品質。把這個處理干擾的問題，接回選擇與分配注意的生活情境。</p><p class="sources">來源：<a href="#ref-6" data-source="6">[6]</a><a href="#ref-7" data-source="7">[7]</a></p></section><section class="slide" data-layout="integration-map" id="p13" hidden><ol class="route" aria-label="課程主線"><li class="read">選擇</li><li class="read">分配</li><li class="read">處理</li><li class="current" aria-current="step">回到生活</li></ol><p class="eyebrow">回到生活</p><h1>選擇、分配、處理，其實問的是同一段生活</h1><p class="lead">三個視角，解釋同一段生活。</p><p class="content-p">選擇問「優先處理什麼」，分配問「多項任務怎麼安排」，處理問「哪些訊息影響反應」。這是教學地圖，不是大腦的固定串行流水線。</p><div class="chapter-map integration"><article class="chapter-node"><h2>選擇</h2><p>讀課文時，把哪一段當成當前目標？</p></article><article class="chapter-node"><h2>分配</h2><p>訊息來了，是繼續讀、同時應付，還是停下來回覆？</p></article><article class="chapter-node"><h2>處理</h2><p>即使決定只看墨色，熟悉字義仍可能干擾反應；選好目標不保證完全排除無關資訊。</p></article></div><aside class="reader-example"><h2>把例子接起來</h2><p>以讀課文、收到訊息與熟悉文字為教學情境，可分別提出三個問題；不表示三種現象必須同時發生。</p></aside><p class="closing">Stroop放在處理段，是為了補上「選定之後，如何反應」的問題。</p><p class="sources">來源：<a href="#ref-1" data-source="1">[1]</a><a href="#ref-4" data-source="4">[4]</a><a href="#ref-6" data-source="6">[6]</a></p></section><section class="slide" data-layout="application-cases" id="p14" hidden><ol class="route" aria-label="課程主線"><li class="read">選擇</li><li class="read">分配</li><li class="read">處理</li><li class="current" aria-current="step">回到生活</li></ol><p class="eyebrow">回到生活</p><h1>把注意力原理變成讀書與駕駛的選擇</h1><p class="lead">把原理變成選擇，而不是追求消滅所有多工。</p><p class="content-p">先認清目標、競爭資訊及任務安排，再提出可嘗試的做法。生活建議要保留條件，不保證固定改善幅度。</p><div class="applications"><article class="application-case"><h2>讀書時</h2><p>可嘗試集中處理非緊急訊息，減少不必要來回切換，再觀察是否較容易接續閱讀。</p></article><article class="application-case"><h2>駕駛時</h2><p>認知分心不只手眼被占用；Noba轉述Strayer與Johnston（2001）的研究，手持與免持通話都可能干擾表現。免持不保證注意力完全保留。</p></article><article class="application-case"><h2>回顧三問及示範</h2><p>我優先處理什麼？例如眼前課文。是同時做還是切換？例如停下來回訊息屬切換。用什麼比較？例如兩件事都完成的總時間與品質。</p></article></div><aside class="reader-example"><h2>輪到你的情境</h2><p>想一個生活例子，試著用三問說清楚；這是理解練習，不是能力量表。</p></aside><p class="closing">駕駛研究依教材轉述，不推估個人事故率。</p><p class="sources">來源：<a href="#ref-1" data-source="1">[1]</a><a href="#ref-4" data-source="4">[4]</a></p></section><section class="slide" data-layout="references" id="sources" hidden><ol class="route" aria-label="課程主線"><li class="read">選擇</li><li class="read">分配</li><li class="read">處理</li><li class="read">回到生活</li></ol><p class="eyebrow">資料與查證</p><h1>資料來源：每個說法都能回頭查</h1><p class="lead">每個說法，都能回頭查。</p><p class="content-p">本簡報知識僅來自已確認的Wiki；完整來源與原始論文／教材轉述的區別保留在來源頁。</p><button id="return-source" class="source-return" disabled>返回引用處</button><ol class="source-list"><li id="ref-1" tabindex="-1"><h2>來源 [1]</h2><p>Frances Friedrich（2026，依網站建議書目）。<a href="https://nobaproject.com/modules/attention" target="_blank" rel="noopener noreferrer">Attention</a>. In R. Biswas-Diener &amp; E. Diener (Eds.), Noba textbook series: Psychology. DEF publishers. 開放教材；The Cocktail Party、Dichotic Listening Studies、Divided Attention and Multitasking、Distracted Driving及References。本次重讀；依教材轉述的研究不算另讀原始論文。</p></li><li id="ref-2" tabindex="-1"><h2>來源 [2]</h2><p>潘震澤（2011-05-27）。<a href="https://pansci.asia/archives/4319" target="_blank" rel="noopener noreferrer">為什麼不要邊開車邊講電話？―人類錯覺大全</a>。泛科學。 科普書評／介紹；注意力錯覺與預期段落；本次沿用先前筆記，不擴張使用範圍。</p></li><li id="ref-3" tabindex="-1"><h2>來源 [3]</h2><p>吴彦文、游旭群（2017）。<a href="https://journal.psych.ac.cn/xlxb/CN/10.3724/SP.J.1041.2017.001267" target="_blank" rel="noopener noreferrer">颜色字词的识别真的无需注意力资源的参与？——来自Stroop范式的证据</a>。《心理学报》，49(10)，1267–1276。DOI:10.3724/SP.J.1041.2017.001267。 原始研究；本次重讀書目與摘要，全文閱讀依前次紀錄；理論背景與結論定位為引言及§5–6。不可把本文的啟動典範等同短遊戲。</p></li><li id="ref-4" tabindex="-1"><h2>來源 [4]</h2><p>American Psychological Association（n.d.）。<a href="https://www.apa.org/topics/research/multitasking" target="_blank" rel="noopener noreferrer">Multitasking: Switching costs</a>。 專業機構解說；本次重讀What the research shows、What the research means與References。Rogers與Monsell等的年份與敘述來自此二手來源，不聲稱另讀原始論文。</p></li><li id="ref-5" tabindex="-1"><h2>來源 [5]</h2><p>Simons, D. J., &amp; Chabris, C. F.（1999）。<a href="https://www.chabris.com/Simons1999.pdf" target="_blank" rel="noopener noreferrer">Gorillas in our midst: Sustained inattentional blindness for dynamic events</a>. Perception, 28(9), 1059–1074. DOI:10.1068/p281059。 原始研究，作者網站PDF；本次重讀引言、方法、結果／Table 1。</p></li><li id="ref-6" tabindex="-1"><h2>來源 [6]</h2><p>Stroop, J. R.（1935）。<a href="https://psychclassics.yorku.ca/Stroop/" target="_blank" rel="noopener noreferrer">Studies of interference in serial verbal reactions</a>. Journal of Experimental Psychology, 18, 643–662. DOI:10.1037/h0054651。 York University 經典文獻HTML轉錄；本次重讀引言與實驗2，原文定位pp.646–651。</p></li><li id="ref-7" tabindex="-1"><h2>來源 [7]</h2><p>PsyToolkit（2026-07-16更新，依前次頁尾紀錄）。<a href="https://www.psytoolkit.org/experiment-library/stroop.html" target="_blank" rel="noopener noreferrer">Stroop task</a>。 官方任務文件；本次重讀Introduction、About this implementation、Data output file，提供Stroop完整姓名與按鍵版比較方法。未執行其示範或複製其程式。</p></li></ol><p class="closing">原文連結需連網；簡報與遊戲離線可用。Noba改寫署名Frances Friedrich／Noba，採CC BY-NC-SA 4.0；其他來源各自保留權利。</p><p class="sources">來源：<a href="#ref-1" data-source="1">[1]</a><a href="#ref-2" data-source="2">[2]</a><a href="#ref-3" data-source="3">[3]</a><a href="#ref-4" data-source="4">[4]</a><a href="#ref-5" data-source="5">[5]</a><a href="#ref-6" data-source="6">[6]</a><a href="#ref-7" data-source="7">[7]</a></p></section></main><footer><span id="page-label" class="page-label main-label"></span><span class="keyboard-hint">左右鍵切換 · 長內容可上下捲動</span><div class="nav"><button id="prev">上一頁</button><button id="next">下一頁</button></div></footer><noscript>請允許本機檔案執行JavaScript，才能使用逐頁導覽與活動。</noscript><script>'use strict';
+const resultFeedback={"switch": {"positive": "這次交替輪較慢，方向與切換需調整目標與規則的預期一致。這不是研究中單一切換題的純成本，也沒有測出「同時做」是否更快。", "zero": "這次兩輪時間相同，未呈現交替輪較慢的預期方向。一次相同不表示切換沒有成本；請連同練習、順序、規則熟悉度與操作情況理解。", "negative": "這次交替輪較快，方向與交替輪較慢的預期不同。練習、順序、規則熟悉度與操作都可能影響；本活動無法判定是哪個原因，也不能因此推翻研究或認定你多工更好。", "insufficient": "這次先不比較快慢：兩輪未完整完成，或逾時／正確情況不適合比較，因此也不判定是否符合研究預期。仍可閱讀下方的研究發現與原理解釋。"}, "stroop": {"positive": "這次不一致條件較慢，方向與字義干擾墨色作答的預期一致。它支持理解這個現象，但一次按鍵結果不能證明機制；原研究用色塊作基準，數值也不能直接相比。", "zero": "這次兩條件平均相同，未呈現不一致較慢的預期方向。一次相同不代表沒有字義干擾；先看練習、題目先後、按鍵操作，以及錯誤與逾時。", "negative": "這次不一致條件較快，方向與字義干擾的預期不同。練習、題目先後、按鍵操作與少量作答都可能影響平均；無法由差值判定原因，也不表示你沒有干擾或注意力更好。", "insufficient": "這次資料不足，先不解讀差值，也不判定是否符合預期。請先看錯誤及逾時；即使跳過，仍可閱讀下方的原研究與干擾原理解釋。"}};
+'use strict';
 const $=s=>document.querySelector(s),slides=[...document.querySelectorAll('.slide')];let current=0;
 const tasks={parity:{label:'判斷奇偶',left:'奇數',right:'偶數',correct:n=>n%2?0:1},magnitude:{label:'比5大或小',left:'小於5',right:'大於5',correct:n=>n<5?0:1}};
 function shuffle(a,rng=Math.random){a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(rng()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
 function makeRound(kind,rng=Math.random){const sets={parity:shuffle([1,2,3,6,7,8],rng),magnitude:shuffle([1,2,3,6,7,8],rng)};const rules=kind==='blocked'?[...Array(6).fill('parity'),...Array(6).fill('magnitude')]:Array.from({length:12},(_,i)=>i%2?'magnitude':'parity');return rules.map(rule=>({rule,n:sets[rule].pop()}))}
 function summarize(rows){const rounds=['blocked','mixed'].map(kind=>{const a=rows.filter(x=>x.kind===kind);return {kind,count:a.length,correct:a.filter(x=>x.status==='correct').length,wrong:a.filter(x=>x.status==='wrong').length,timeout:a.filter(x=>x.status==='timeout').length,total:a.reduce((sum,x)=>sum+x.rt,0)}});const eligible=rounds.every(x=>x.count===12&&x.timeout===0&&x.correct>=10)&&rounds[0].correct===rounds[1].correct;return {rounds,eligible,delta:eligible?rounds[1].total-rounds[0].total:null}}
+function feedbackFor(kind,summary){const branch=!summary.eligible?'insufficient':summary.delta>0?'positive':summary.delta<0?'negative':'zero';return resultFeedback[kind][branch]}
 const game={phase:'intro',locked:true,timer:null,next:null,trials:[],i:0,rows:[],order:[],round:0,started:0,result:null};
