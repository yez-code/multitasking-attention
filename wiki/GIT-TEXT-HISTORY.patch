4vw;background:var(--paper)}.progress{height:3px;flex:1;background:var(--line);border-radius:8px}.progress span{display:block;height:100%;background:var(--green);transition:width .15s}.page-count{font-variant-numeric:tabular-nums;font-size:13px;min-width:45px}.nav{display:flex;gap:8px}.nav button,.plain-button{border:1px solid var(--line);background:transparent;border-radius:6px;padding:10px 16px;font-size:14px}.nav button:last-child,.primary{background:var(--ink)!important;color:var(--white)!important;border-color:var(--ink)!important}.hint{font-size:12px;color:var(--muted)}.game-shell{display:grid;grid-template-columns:1fr 1.25fr;gap:28px}.game-panel{background:var(--white);border:1px solid var(--line);border-radius:12px;padding:22px;text-align:center;min-width:0}.game-status{font-size:14px;color:var(--muted);min-height:25px;margin:0 0 10px}.stimulus{font-size:72px;font-weight:800;line-height:1.5;min-height:108px}.answer-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.answer-grid button{padding:13px 4px;border:1px solid var(--line);background:var(--paper);border-radius:6px;font-size:16px}.answer-grid kbd{font-size:12px;display:block;color:var(--muted);margin-top:3px}.game-actions{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin-top:14px}.feedback{font-size:13px;line-height:1.7;min-height:24px;margin:10px 0;color:var(--muted)}.results{display:grid;grid-template-columns:1fr 1fr;gap:10px}.metric{border:1px solid var(--line);padding:15px;border-radius:8px}.metric b{display:block;font-size:26px;margin:8px 0;color:var(--green)}.metric small{font-size:13px;line-height:1.6;color:var(--muted)}.delta{grid-column:1/-1;background:var(--lime);padding:18px;border-radius:8px;font-size:18px;line-height:1.6}.results-empty{font-size:16px;line-height:1.8;color:var(--muted)}noscript{padding:20px} @media(max-width:800px){.spread,.game-shell{grid-template-columns:1fr}.source-list{grid-template-columns:1fr}.figure{min-height:170px}.slide{gap:18px}main{pa